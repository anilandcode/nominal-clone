{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "clone",
  "framework": null,
  "installCommand": "echo \"no dependencies - static SSR mirror\"",
  "buildCommand": "echo \"no build step - serving SSR output as-is\"",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_nuxt/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
