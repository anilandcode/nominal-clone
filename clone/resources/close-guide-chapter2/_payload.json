30,"page":349,"type":34,"url":9},{"slug":169,"title":170},{"_key":351,"_type":28,"link":352,"text":176},"37977fbb53f2",{"linkPageModule":30,"newTab":30,"page":353,"type":34,"url":9},{"slug":175,"title":176},{"_key":355,"_type":28,"link":356,"text":182},"ce7211bbdf06",{"linkPageModule":30,"newTab":30,"page":357,"type":34,"url":9},{"slug":181,"title":182},{"_key":359,"_type":28,"link":360,"text":189},"c2cf79578089",{"linkPageModule":30,"newTab":30,"page":361,"type":34,"url":9},{"slug":188,"title":189},{"_key":363,"_type":28,"link":364,"text":158},"aa5c056f571d",{"linkPageModule":30,"newTab":30,"page":365,"type":34,"url":9},{"slug":157,"title":158},"By ERP","Solutions",{"_key":369,"_type":261,"children":370,"hasChildren":59,"hasComplex":30,"hasSubGroups":30,"label":117},"3ed1e90daf42",[371,375,379,383],{"_key":372,"_type":28,"link":373,"text":103},"ccdb6f145286",{"linkPageModule":30,"newTab":30,"page":374,"type":34,"url":9},{"slug":102,"title":103},{"_key":376,"_type":28,"link":377,"text":110},"8b88bd492913",{"linkPageModule":30,"newTab":30,"page":378,"type":34,"url":9},{"slug":109,"title":110},{"_key":380,"_type":28,"link":381,"text":116},"543fda435ee0",{"linkPageModule":30,"newTab":30,"page":382,"type":34,"url":9},{"slug":115,"title":116},{"_key":384,"_type":28,"link":385,"text":148},"d668686708d7",{"linkPageModule":30,"newTab":30,"page":386,"type":34,"url":9},{"slug":146,"title":147},{"_key":388,"_type":261,"children":389,"hasChildren":59,"hasComplex":30,"hasSubGroups":59,"label":224},"ec3c9c96a73a",[390,412],{"_key":391,"_type":320,"children":392,"label":411},"7f3f46db00b2",[393,397,401,405],{"_key":394,"_type":28,"link":395,"text":199},"91346855e74b",{"linkPageModule":30,"newTab":30,"page":396,"type":34,"url":9},{"slug":198,"title":9},{"_key":398,"_type":28,"link":399,"text":205},"73e52b9d612e",{"linkPageModule":30,"newTab":30,"page":400,"type":34,"url":9},{"slug":204,"title":9},{"_key":402,"_type":28,"link":403,"text":211},"6039453eeab9",{"linkPageModule":30,"newTab":30,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"categories":427,"content":435,"formRef":9,"formats":789,"globalSeo":796,"headerImage":797,"orderRank":808,"pageModules":9,"searchTerms":809,"seo":812,"slug":819,"sock":820,"text":825,"thumbnailImage":826,"title":810},"c123db5c-a5a5-4057-b49f-dbf588971d29","5JxOCKB3i8O4GorSx3iA8f","resourceEntry",[428],{"_id":429,"group":430,"slug":431,"title":434},"YaDLP90G7d4pbJlQpPJOjJ","resource-category",{"_type":432,"current":433},"slug","\u002Ftag\u002Fresource-category\u002Fclose-management","Close Management",[436,448,456,464,473,481,488,496,504,512,520,529,537,557,565,582,590,598,606,614,622,630,638,646,654,662,670,678,686,694,709,717,725,733,741,749,764,785],{"_key":437,"_type":438,"children":439,"markDefs":446,"style":447},"4ac431eb3ad6","toolbar",[440],{"_key":441,"_type":442,"marks":443,"text":445},"3b812e512bea","span",[444],"em","Manual month-end processes drain time, increase risk, and block finance teams from delivering strategic insight. This chapter unpacks the hidden costs of a broken close and explains how automation helps teams move faster, improve accuracy, and refocus on higher-value work.",[],"normal",{"_key":449,"_type":438,"children":450,"markDefs":455,"style":447},"05cc079a4dc4",[451],{"_key":452,"_type":442,"marks":453,"text":454},"765d6aec607d",[],"Let’s be honest: the hidden cost of a broken close doesn’t always show up on a spreadsheet. It hides in the late nights, the endless spreadsheets, the stress that never seems to end. When month-end depends on delayed reports, manual reconciliations, and systems that don’t talk to each other, the problem isn’t just lost hours. It’s more risk, more pressure, and less time for the kind of work that actually moves the business forward.",[],{"_key":457,"_type":438,"children":458,"markDefs":463,"style":447},"842b34b0de40",[459],{"_key":460,"_type":442,"marks":461,"text":462},"c5d4dd2a10ee",[],"Here’s the good news: it doesn’t have to stay that way. AI and automation can step in like the ultimate problem-solvers. They streamline consolidation, automate reconciliations, and give real-time visibility, taking the weight off everyone’s shoulders. The result isn’t just a faster close; it’s a smarter, more accurate one and it frees up space for the work that really matters.",[],{"_key":465,"_type":438,"children":466,"markDefs":471,"style":472},"1571c426252d",[467],{"_key":468,"_type":442,"marks":469,"text":470},"ee9ee8a7c5fa",[],"What “Broken Close” Really Means",[],"h2",{"_key":474,"_type":438,"children":475,"markDefs":480,"style":447},"d62200434cbb",[476],{"_key":477,"_type":442,"marks":478,"text":479},"1c4ceaed2e89",[],"Month-end close can feel like running on a treadmill that never stops. It is exhausting, repetitive, and painfully slow. Many finance teams do not realize how broken their processes have become until deadlines slip, auditors start raising concerns, or leadership loses patience with late reports. ",[],{"_key":482,"_type":438,"children":483,"markDefs":487,"style":447},"6b37c8b794eb",[484],{"_key":477,"_type":442,"marks":485,"text":486},[],"A broken close is not just a spreadsheet error. It is a sign of a system weighed down by fragmented workflows, delayed reporting, and endless manual reconciliations. These issues create overtime, stress employees, and drain opportunities because outdated tools keep everyone stuck.",[],{"_key":489,"_type":438,"children":490,"markDefs":495,"style":447},"6ecf80e9eef0",[491],{"_key":492,"_type":442,"marks":493,"text":494},"d07d04d83903",[],"However, recognizing the hidden costs of a broken month-end close, including time, risk, and missed opportunities, can bring instant clarity. From that point, automation and AI can lift much of the repetitive, time-consuming work so teams can redirect their energy to strategy and higher-value contributions.",[],{"_key":497,"_type":438,"children":498,"markDefs":503,"style":472},"57735cb34158",[499],{"_key":500,"_type":442,"marks":501,"text":502},"217334de6836",[],"The Time Cost: How Broken Processes Drag Out the Close",[],{"_key":505,"_type":438,"children":506,"markDefs":511,"style":447},"474d90d1a88d",[507],{"_key":508,"_type":442,"marks":509,"text":510},"5921d38cd0eb",[],"Closing the books resembles conducting an orchestra across time zones, entities, and accounting standards. Every element must be in place and coordinated for the process to run smoothly.",[],{"_key":513,"_type":438,"children":514,"markDefs":519,"style":447},"1dc62ab38fe5",[515],{"_key":516,"_type":442,"marks":517,"text":518},"f46db18c9f4d",[],"For many mid-market and multi-entity organizations, the average close stretches from six to ten days, sometimes extending to two weeks or longer when manual processes dominate. The main time drains include:",[],{"_key":521,"_type":438,"children":522,"level":17,"listItem":527,"markDefs":528,"style":447},"50b983277603",[523],{"_key":524,"_type":442,"marks":525,"text":526},"e98135819b1c",[],"Reconciliations: Matching transactions between bank statements, intercompany ledgers, and ERP outputs.","bullet",[],{"_key":530,"_type":438,"children":531,"level":17,"listItem":527,"markDefs":536,"style":447},"3b4bc36521a4",[532],{"_key":533,"_type":442,"marks":534,"text":535},"5f7ef412c18d",[],"Data gathering: Pulling trial balances and subledger details from multiple systems.",[],{"_key":538,"_type":438,"children":539,"level":17,"listItem":527,"markDefs":553,"style":447},"af44a3c418f6",[540,544,549],{"_key":541,"_type":442,"marks":542,"text":543},"1f7a96b4f34a",[],"Error correction: Investigating discrepancies, reposting entries, and validating ",{"_key":545,"_type":442,"marks":546,"text":548},"60ffd56bfa3c",[547],"8faca58cb6b8","intercompany eliminations",{"_key":550,"_type":442,"marks":551,"text":552},"7821f5b6de01",[],".",[554],{"_key":547,"_type":555,"linkPageModule":30,"newTab":30,"page":9,"type":124,"url":556},"link","https:\u002F\u002Fnominal.so\u002Fblog\u002Fintercompany-eliminations?__hstc=753710.3710cbe0e4aede935b83de9c18eb258f.1777485799801.1777485799801.1777485799801.1&__hssc=753710.1.1777485799802&__hsfp=ae3f0c1773956dc2d264706c578d932d",{"_key":558,"_type":438,"children":559,"level":17,"listItem":527,"markDefs":564,"style":447},"a1ae46ff0c80",[560],{"_key":561,"_type":442,"marks":562,"text":563},"e0e68edb923c",[],"Version control: Maintaining multiple spreadsheets and email chains to manage approvals.",[],{"_key":566,"_type":567,"data":568,"image":579,"markDefs":9,"type":580},"6c943d7796f0","media",{"alt":9,"altText":569,"asset":570,"bgColor":572,"caption":9,"dimensions":573,"lqip":577,"originalFilename":578},"Nominal infographic showing the time, risk, and opportunity costs of a broken month-end close, including statistics on error rates, audit findings, and manual effort",{"_ref":571,"_type":13},"image-0b775c475cd3220669148c7887af14e807c5698b-1280x3756-png","#ddc1b9",{"_type":16,"aspectRatio":574,"height":575,"width":576},0.3407880724174654,3756,1280,"data:image\u002Fpng;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAA7CAYAAAB7c6ruAAAACXBIWXMAAAsTAAALEwEAmpwYAAALEElEQVR4nK2V+W8c53nH+TdIXFIiVxR1kJRI6gp6ALXdX9IGRVG4SeRAamrFdevEcZwiRdu4Rpy6hdGkihWkdmVblMglJdqyDuui5Ki6LImqZFGiLov38j6We8zOzM7unDu7+yned0maVmKhBfrDFzPzvO\u002F7nWfe5\u002FM+U3JaG+H\u002FUyWPGzwZH+To9EM+munh+GwfJ2L9nFLCnFb\u002FD4Yd6vCCDo3fZ9\u002FdT9h39zKtD6\u002FRPnCTY5FeOfa\u002FMuxIDs