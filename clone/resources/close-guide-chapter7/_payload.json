Tab":30,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"categories":427,"content":435,"formRef":9,"formats":861,"globalSeo":868,"headerImage":869,"orderRank":880,"pageModules":9,"searchTerms":881,"seo":883,"slug":890,"sock":891,"text":445,"thumbnailImage":896,"title":870},"fb591a6b-7852-4ad0-9088-2ef7252e2e94","5JxOCKB3i8O4GorSx3i9H9","resourceEntry",[428],{"_id":429,"group":430,"slug":431,"title":434},"YaDLP90G7d4pbJlQpPJOjJ","resource-category",{"_type":432,"current":433},"slug","\u002Ftag\u002Fresource-category\u002Fclose-management","Close Management",[436,448,456,465,484,501,518,535,552,569,577,585,593,601,610,618,626,634,642,650,658,666,674,691,699,707,715,723,731,739,747,755,763,775,783,791,799,807,815,823,831,839,857],{"_key":437,"_type":438,"children":439,"markDefs":446,"style":447},"7822b9c37297","toolbar",[440],{"_key":441,"_type":442,"marks":443,"text":445},"1e9db219bb5b","span",[444],"em","A finance team's journey from Excel-based consolidation to autonomous execution with Agentic Performance Management.",[],"normal",{"_key":449,"_type":438,"children":450,"markDefs":455,"style":447},"0bcee97b9f3c",[451],{"_key":452,"_type":442,"marks":453,"text":454},"032516fcf56d",[],"The Complete Guide to Close 2026 has covered the full transformation journey from broken manual processes to autonomous execution. Over six chapters, the guide explored diagnosing close problems, understanding modern automation, and implementing platforms that fundamentally change how finance operates.",[],{"_key":457,"_type":438,"children":458,"markDefs":463,"style":464},"1dc468b5090d",[459],{"_key":460,"_type":442,"marks":461,"text":462},"f71ec04a56bf",[],"The Journey So Far",[],"h2",{"_key":466,"_type":438,"children":467,"level":17,"listItem":477,"markDefs":478,"style":447},"c753793bc5d6",[468,473],{"_key":469,"_type":442,"marks":470,"text":472},"fada2a2823d1",[471],"51c368cbd94a","Chapter 1",{"_key":474,"_type":442,"marks":475,"text":476},"b749d53b306e",[]," provided a benchmark quiz to assess current close maturity and identify starting points.","bullet",[479],{"_key":471,"_type":480,"linkPageModule":30,"newTab":30,"page":481,"type":34,"url":9},"link",{"slug":482,"title":483},"\u002Fresources\u002Fclose-guide-chapter1","Where Does Your Close Stand Today?",{"_key":485,"_type":438,"children":486,"level":17,"listItem":477,"markDefs":496,"style":447},"667c3338c0af",[487,492],{"_key":488,"_type":442,"marks":489,"text":491},"e5888bbf4e86",[490],"76d553531ff1","Chapter 2",{"_key":493,"_type":442,"marks":494,"text":495},"b3705725b310",[]," revealed the hidden costs of manual closes: time drains, risk exposure, and strategic opportunities lost when finance teams remain stuck in operational mode.",[497],{"_key":490,"_type":480,"linkPageModule":30,"newTab":30,"page":498,"type":34,"url":9},{"slug":499,"title":500},"\u002Fresources\u002Fclose-guide-chapter2","The Cost of a Broken Close",{"_key":502,"_type":438,"children":503,"level":17,"listItem":477,"markDefs":513,"style":447},"c894cd148131",[504,509],{"_key":505,"_type":442,"marks":506,"text":508},"7cccd0d5a78f",[507],"d8f7dcb9aa9f","Chapter 3",{"_key":510,"_type":442,"marks":511,"text":512},"875b14a28823",[]," showed what a modern close actually looks like, with real-time data sync, automated reconciliations, and continuous consolidation replacing spreadsheet chaos.",[514],{"_key":507,"_type":480,"linkPageModule":30,"newTab":30,"page":515,"type":34,"url":9},{"slug":516,"title":517},"\u002Fresources\u002Fclose-guide-chapter3","What a Modern Close Looks Like",{"_key":519,"_type":438,"children":520,"level":17,"listItem":477,"markDefs":530,"style":447},"c8b71629e40b",[521,526],{"_key":522,"_type":442,"marks":523,"text":525},"476cb9cf1e25",[524],"5232a901dd59","Chapter 4",{"_key":527,"_type":442,"marks":528,"text":529},"0a2d0637064e",[]," walked through specific automation opportunities in reconciliations, intercompany eliminations, variance analysis, and workflow management that transform finance operations.",[531],{"_key":524,"_type":480,"linkPageModule":30,"newTab":30,"page":532,"type":34,"url":9},{"slug":533,"title":534},"\u002Fresources\u002Fclose-guide-chapter4","Automating the Close Process",{"_key":536,"_type":438,"children":537,"level":17,"listItem":477,"markDefs":547,"style":447},"a5bc5564ddc9",[538,543],{"_key":539,"_type":442,"marks":540,"text":542},"d438bc6774dd",[541],"e213bb756de6","Chapter 5",{"_key":544,"_type":442,"marks":545,"text":546},"3faccf896940",[]," helped evaluate performance management software, distinguishing between tools that organize tasks, AI that assists, and Agentic Performance Management platforms that execute autonomously.",[548],{"_key":541,"_type":480,"linkPageModule":30,"newTab":30,"page":549,"type":34,"url":9},{"slug":550,"title":551},"\u002Fresources\u002Fclose-guide-chapter5","How to Choose Agentic Performance Management Software for Close",{"_key":553,"_type":438,"children":554,"level":17,"listItem":477,"markDefs":564,"style":447},"8dff95c88b5c",[555,560],{"_key":556,"_type":442,"marks":557,"text":559},"a53c4786e771",[558],"e93eb36c508a","Chapter 6",{"_key":561,"_type":442,"marks":562,"text":563},"ad8e903092c2",[]," provided a practical 30-day implementation roadmap, showing how finance teams deploy automation without IT dependencies or system overhauls.",[565],{"_key":558,"_type":480,"linkPageModule":30,"newTab":30,"page":566,"type":34,"url":9},{"slug":567,"title":568},"\u002Fresources\u002Fclose-guide-chapter6","Implementation Tips That Actually Work",{"_key":570,"_type":438,"children":571,"markDefs":576,"style":447},"d92ebe411b19",[572],{"_key":573,"_type":442,"marks":574,"text":575},"fddfffc808fe",[],"Now comes the practical application: seeing theory become reality through a finance team that made this exact transformation.",[],{"_key":578,"_type":438,"children":579,"markDefs":584,"style":464},"df25da56e44c",[580],{"_key":581,"_type":442,"marks":582,"text":583},"870ac9e49c58",[],"Real-Time Consolidation: From Days of Delays to Instant Visibility",[],{"_key":586,"_type":438,"children":587,"markDefs":592,"style":447},"7eb0798d2723",[588],{"_key":589,"_type":442,"marks":590,"text":591},"a85cb9b2a135",[],"Manual consolidation represents one of the biggest bottlenecks in multi-entity closes. Finance teams wait until every entity finishes their work, then spend days combining reports, checking account mappings, verifying formulas, and hunting for discrepancies. Leadership operates on information that's already outdated by the time it reaches them.",[],{"_key":594,"_type":438,"children":595,"markDefs":600,"style":447},"f43994b14988",[596],{"_key":597,"_type":442,"marks":598,"text":599},"a7ccc527a199",[],"Dušica Brkić, Accounting and Controlling Specialist at Leanpay, experienced this firsthand.",[],{"_key":602,"_type":438,"children":603,"markDefs":608,"style":609},"a71502ed8381",[604],{"_key":605,"_type":442,"marks":606,"text":607},"c1d684e1e85e",[],"\"It was one Excel table with sheets of all subsidiaries. You would need to submit manually and check if everything is matched or not. Then transform this with the national column into consolidated reports for balance sheet and P&L. To check, to zoom again everything. If the result is not zero for interco transactions, then you need to find an explanation. It was really hard.”",[],"h5",{"_key":611,"_type":438,"children":612,"markDefs":617,"style":447},"ed43b2d1201c",[613],{"_key":614,"_type":442,"marks":615,"text":616},"adbad913605b",[],"With autonomous agents, the entire workflow transforms. As individual entities complete their work, consolidated results update automatically. Currency translations happen in real-time using current exchange rates. Account mappings validate instantly, flagging unmapped accounts or incorrect coding immediately rather than days later.",[],{"_key":619,"_type":438,"children":620,"markDefs":625,"style":447},"d5b54457bf3f",[621],{"_key":622,"_type":442,"marks":623,"text":624},"6cf3cd6afabe",[],"The shift from sequential to parallel processing changes everything. Instead of waiting two weeks for final consolidated numbers, finance teams see preliminary results throughout the close. Controllers can spot trends, investigate variances, and prepare commentary while the close is still in progress rather than scrambling after everything locks.",[],{"_key":627,"_type":438,"children":628,"markDefs":633,"style":609},"0baeccdf4dcc",[629],{"_key":630,"_type":442,"marks":631,"text":632},"2b6aed61c56a",[],"\"Now I can easily compare everything from month to previous month. I can customize a report, try to find something. It's much easier to find mistakes,\" Dušica notes. \"I can easily see if something is wrong with the exchange rates because I can see if it's not zero, then it's a mistake with eliminations or adjustments or exchange rates. It's 50% less time to find mistakes.\"",[],{"_key":635,"_type":438,"children":636,"markDefs":641,"style":447},"c7a27a0ed95a",[637],{"_key":638,"_type":442,"marks":639,"text":640},"e531fba2805d",[],"That 50% time reduction doesn't just mean faster closes. It means catching errors before they impact results. It means answering leadership questions with current data instead of week-old snapshots. It means finance teams spending time on analysis instead of validation.",[],{"_key":643,"_type":438,"children":644,"markDefs":649,"style":464},"1f965601eb89",[645],{"_key":646,"_type":442,"marks":647,"text":648},"e848d035903c",[],"Intercompany Eliminations: From Manual Matching to Autonomous Execution",[],{"_key":651,"_type":438,"children":652,"markDefs":657,"style":447},"55725d6e719a",[653],{"_key":654,"_type":442,"marks":655,"text":656},"5b8a57ec8e94",[],"Intercompany eliminations represent the most complex and error-prone aspect of multi-entity consolidation. Transactions between entities must be identified, matched, and eliminated from consolidated results. Currency conversions need to apply appropriate exchange rates. The slightest mismatch creates hours of investigation work.",[],{"_key":659,"_type":438,"children":660,"markDefs":665,"style":447},"3d2405bf31cb",[661],{"_key":662,"_type":442,"marks":663,"text":664},"c2b41d2bab8d",[],"Traditional approaches require maintaining separate spreadsheets to track transactions between entities, manually identifying matches across different subsidiaries, applying currency conversions with formulas that break when formats change, and generating elimination entries that must be validated across multiple dimensions.",[],{"_key":667,"_type":438,"children":668,"markDefs":673,"style":447},"6afe50fb1111",[669],{"_key":670,"_type":442,"marks":671,"text":672},"f50313b06582",[],"Autonomous agents handle this entire workflow systematically. The platform identifies intercompany transactions based on configurable matching rules. Currency conversions happen automatically using real-time exchange rates appropriate for transaction types. Elimination entries generate based on predefined logic that reflects accounting standards and company policies.",[],{"_key":675,"_type":676,"data":677,"image":688,"markDefs":9,"type":689},"2a6a74cce571","media",{"alt":9,"altText":678,"asset":679,"bgColor":681,"caption":9,"dimensions":682,"lqip":686,"originalFilename":687},"Nominal's intercompany elimination task showing matched transactions on the left and automatically generated elimination entry on the right with approval workflow",{"_ref":680,"_type":13},"image-0196f9d64e8ef4a7da1c85f812b0bc02a1e31061-1344x900-png","#2b52e9",{"_type":16,"aspectRatio":683,"height":684,"width":685},1.4933333333333334,900,1344,"data:image\u002Fpng;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAANCAYAAACpUE5eAAAACXBIWXMAAAsTAAALEwEAmpwYAAAB10lEQVR4nJ2Ru47UQBBF\u002Ff\u002FfRERCRI4EEhl4xp52v9\\u002FzbcDMZXXBwvhv\u002FWn71+XlFRh2b5cTtQJqFd\u002FW8JkHGJ7aH4Bbcp8Qdmx6A3AAAAAElFTkSuQmCC","Task _ FullView _ Intercompany Elimination .png",{"_type":689,"asset":690},"image",{"_ref":680,"_type":13},{"_key":692,"_type":438,"children":693,"markDefs":698,"style":609},"4c97608e9862",[694],{"_key":695,"_type":442,"marks":696,"text":697},"86c73a60d6ff",[],"\"Before it was one Excel table with sheets of all subsidiaries, and then the accountant would put the data there for each month, and you would need to submit manually and to check if everything is matched or not. Now, it is a task for all accountants because it's really just a few clicks.\"",[],{"_key":700,"_type":438,"children":701,"markDefs":706,"style":447},"9fbfd4295bff",[702],{"_key":703,"_type":442,"marks":704,"text":705},"18a71b7a6930",[444],"Dušica Brkić, Accounting and Controlling Specialist at Leanpay",[],{"_key":708,"_type":438,"children":709,"markDefs":714,"style":447},"a1707bd6d48d",[710],{"_key":711,"_type":442,"marks":712,"text":713},"a4d85ebd8a41",[],"The democratization of complex workflows matters as much as the time savings. Work that previously required specialized controller expertise now becomes standard accounting tasks. Team members who spent hours on manual matching now focus on investigating genuine exceptions. The bottleneck shifts from processing capacity to business judgment.",[],{"_key":716,"_type":438,"children":717,"markDefs":722,"style":447},"21a0a2cffe9a",[718],{"_key":719,"_type":442,"marks":720,"text":721},"3aaa5e204789",[],"What happens when something doesn't match? Autonomous agents flag the exception immediately with context about what's missing and where the discrepancy exists. Finance teams investigate business reasons rather than hunting through spreadsheets for formula errors or data entry mistakes.",[],{"_key":724,"_type":438,"children":725,"markDefs":730,"style":447},"c83f28ff9d25",[726],{"_key":727,"_type":442,"marks":728,"text":729},"5ce78ffcafbb",[],"\"If something is missing, then it is something that you can explain. It's not some mistake that you just didn't see,\" Dušica explains. This distinction transforms month-end from error detection to business analysis.",[],{"_key":732,"_type":438,"children":733,"markDefs":738,"style":464},"0df79ffbc927",[734],{"_key":735,"_type":442,"marks":736,"text":737},"d0d70f701871",[],"The Autonomous Advantage: Execution, Not Assistance",[],{"_key":740,"_type":438,"children":741,"markDefs":746,"style":447},"e5577ee6f026",[742],{"_key":743,"_type":442,"marks":744,"text":745},"008a36f923f3",[],"These examples illustrate the fundamental difference between tools that assist finance teams and platforms that autonomously execute workflows.",[],{"_key":748,"_type":438,"children":749,"markDefs":754,"style":447},"eee8a4fed12a",[750],{"_key":751,"_type":442,"marks":752,"text":753},"94a78ebdf23a",[],"AI assistants suggest transaction matches that humans still need to review. Autonomous agents perform the reconciliation and escalate only genuine exceptions.",[],{"_key":756,"_type":438,"children":757,"markDefs":762,"style":447},"6ddba8990e06",[758],{"_key":759,"_type":442,"marks":760,"text":761},"da87afe8fa6f",[],"Workflow tools route tasks and track completion. Autonomous agents execute the underlying accounting work.",[],{"_key":764,"_type":676,"data":765,"image":773,"markDefs":9,"type":689},"4e7eeddbf266",{"alt":9,"altText":766,"asset":767,"bgColor":769,"caption":9,"dimensions":770,"lqip":771,"originalFilename":772},"Nominal agent screen for Intercompany Elimination showing the input reasoning steps and a numbered task sequence",{"_ref":768,"_type":13},"image-985c0d4e6dad9003bd37ac90eb3ca520070e2465-1344x900-png","#3861ea",{"_type":16,"aspectRatio":683,"height":684,"width":685},"data:image\u002Fpng;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAANCAYAAACpUE5eAAAACXBIWXMAAAsTAAALEwEAmpwYAAABxElEQVR4nI2Sx67bMBAA\u002Ff8\u002FmEMOCRA\u002FSZTE3kS1CUgZz3YachgQXGAH2259L5BSo7XDGkeMiZzz\u002F5My3me0DggxcRvEhFQWpQPWRVIqlHVn3SrHRf0\u002FKA+WslHKdsXKTkyFWWpu3aCYVEDqjDYZ6woh7sR8kJbzjZh3QtzwccX5BR9W8nKwrCcxrUyz4XbvNP0UGObAMHrEFJhVRpoFZQvGb7h04OKOcRllIlIHpAoYm4lpI5eDkFbGyXDrhEXMkU447p3hozdNPMrIrBLarQ\u002FhhrIRqRyzdCjtcT6T8sZSjlZhEw6TZ9aZ+naDpR8d4xxarFZo\u002FYZP50OYkNq3eSuTcKGQl\u002F1dKB7C2movHGIOTDK1WG3buDqzR8u+YNzCpArfupW72HCxzvpoc30KVW5t1vbr24\u002F+c55VWpOuKmvigVAHX77vfP2xo1xd1okLG8Nkq9Bdwlrh6Frrlf43IYR8YQNM5mQ2JzbW2JvQo8yCNM\u002FNvmL93qp7Fb7i2\u002FtLhTas+FQT6\u002FrPTy7ReSX+RXjxJrRNGNLeeD3ouFxCF5\u002FyP3M0x1CX0guNNgnrFqxfCHEl5ot6rPUOlV0x\u002Ft8om\u002FkYFD8BQjHo4j0XpsIAAAAASUVORK5CYII=","Agent-Run-_-Intercompany-Elimination-_-Audit.png",{"_type":689,"asset":774},{"_ref":768,"_type":13},{"_key":776,"_type":438,"children":777,"markDefs":782,"style":447},"2b61c43872f8",[778],{"_key":779,"_type":442,"marks":780,"text":781},"8cabcfd5da37",[],"Consolidation software organizes entity data. Autonomous agents process consolidation, eliminate intercompany transactions, and validate results.",[],{"_key":784,"_type":438,"children":785,"markDefs":790,"style":447},"6da7f6dfb0e5",[786],{"_key":787,"_type":442,"marks":788,"text":789},"85fba391f7f7",[],"The impact difference is dramatic. Assistive tools make manual processes more efficient. Autonomous execution eliminates the manual bottleneck entirely. One approach optimizes existing capacity. The other fundamentally expands what teams can accomplish without adding headcount.",[],{"_key":792,"_type":438,"children":793,"markDefs":798,"style":464},"2ec0d089112b",[794],{"_key":795,"_type":442,"marks":796,"text":797},"e14b3715706d",[],"The Path Forward",[],{"_key":800,"_type":438,"children":801,"markDefs":806,"style":447},"e5a0b3055e97",[802],{"_key":803,"_type":442,"marks":804,"text":805},"86959069f636",[],"The Complete Guide to Close 2026 started with a simple question: where does the close stand today? By this point, the answer is clear. More importantly, what's possible is clear, along with what to evaluate and how to move forward.",[],{"_key":808,"_type":438,"children":809,"markDefs":814,"style":447},"a6b2eca90ead",[810],{"_key":811,"_type":442,"marks":812,"text":813},"4d9e200c62e0",[],"The finance organizations winning won't be the ones with the biggest teams. They'll be the ones running on Agentic Performance Management, letting autonomous agents execute operations while their talent drives actual business value.",[],{"_key":816,"_type":438,"children":817,"markDefs":822,"style":447},"c0f2e8b4ad2f",[818],{"_key":819,"_type":442,"marks":820,"text":821},"094c2473fb1c",[],"The choice is clear. Continue managing manual processes that consume capacity and delay insights, or deploy autonomous execution that scales without limit.",[],{"_key":824,"_type":438,"children":825,"markDefs":830,"style":447},"b977e0dc3e84",[826],{"_key":827,"_type":442,"marks":828,"text":829},"5da0aed44eeb",[],"The transformation starts with a single step. Book the demo. Start the conversation.",[],{"_key":832,"_type":438,"children":833,"markDefs":838,"style":447},"942969dd333d",[834],{"_key":835,"_type":442,"marks":836,"text":837},"16bbac2915a7",[],"The close doesn't have to stay broken. The tools to fix it exist today.",[],{"_key":840,"_type":438,"children":841,"markDefs":854,"style":447},"eb7e3318dc46",[842,846,850],{"_key":843,"_type":442,"marks":844,"text":845},"e588533a03f1",[],"Ready to transform your close? ",{"_key":847,"_type":442,"marks":848,"text":252},"3ec6ce54b264",[849],"0ae3f8907ef9",{"_key":851,"_type":442,"marks":852,"text":853},"a6545c956681",[]," with Nominal.",[855],{"_key":849,"_type":480,"linkPageModule":30,"newTab":30,"page":856,"type":34,"url":9},{"slug":251,"title":252},{"_key":858,"_type":859,"fullWidth":9,"htmlCode":860,"label":9,"markDefs":9},"671a90d9d0a7","htmlEmbed","\u003C!--HubSpot Call-to-Action Code -->\u003Cspan class=\"hs-cta-wrapper\" id=\"hs-cta-wrapper-79280e37-1b52-4ffd-aa40-0b18bad6ba71\">\u003Cspan class=\"hs-cta-node hs-cta-79280e37-1b52-4ffd-aa40-0b18bad6ba71\" id=\"hs-cta-79280e37-1b52-4ffd-aa40-0b18bad6ba71\">\u003C!--[if lte IE 8]>\u003Cdiv id=\"hs-cta-ie-element\">\u003C\u002Fdiv>\u003C![endif]-->\u003Ca href=\"https:\u002F\u002Fcta-redirect.hubspot.com\u002Fcta\u002Fredirect\u002F48589798\u002F79280e37-1b52-4ffd-aa40-0b18bad6ba71\" target=\"_blank\" rel=\"noopener\">\u003Cimg class=\"hs-cta-img\" id=\"hs-cta-img-79280e37-1b52-4ffd-aa40-0b18bad6ba71\" style=\"border-width:0px;\" src=\"https:\u002F\u002Fno-cache.hubspot.com\u002Fcta\u002Fdefault\u002F48589798\u002F79280e37-1b52-4ffd-aa40-0b18bad6ba71.png\"  alt=\"   See Nominal in action  Schedule a free, personalized demo to explore how we can help your team        Book now \"\u002F>\u003C\u002Fa>\u003C\u002Fspan>\u003Cscript charset=\"utf-8\" src=\"https:\u002F\u002Fjs.hscta.net\u002Fcta\u002Fcurrent.js\">\u003C\u002Fscript>\u003Cscript type=\"text\u002Fjavascript\"> hbspt.cta.load(48589798, '79280e37-1b52-4ffd-aa40-0b18bad6ba71', {\"useNewLoader\":\"true\",\"region\":\"na1\"}); \u003C\u002Fscript>\u003C\u002Fspan>\u003C!-- end HubSpot Call-to-Action Code -->",[862],{"_id":863,"group":864,"slug":865,"title":867},"WHRc5NKIhsva8iXeVqk2js","resource-format",{"_type":432,"current":866},"\u002Ftag\u002Fresource-format\u002FGuides","Guides",{"description":9,"image":9,"title":9},{"alt":9,"altText":870,"asset":871,"bgColor":873,"caption":9,"dimensions":874,"lqip":878,"originalFilename":879},"A Real Close with Nominal",{"_ref":872,"_type":13},"image-7d62c971ae9e26cd13d0fed2860a250bfaafb1bd-376x279-svg","#d45c5c",{"_type":16,"aspectRatio":875,"height":876,"width":877},1.3476702508960574,279,376,"data:image\u002Fjpeg;base64,\u002F9j\u002F2wBDAAYEBQYFBAYGBQYHBwYIChAKCgkJChQODwwQFxQYGBcUFhYaHSUfGhsjHBYWICwgIyYnKSopGR8tMC0oMCUoKSj\u002F2wBDAQcHBwoIChMKChMoGhYaKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCj\u002FwAARCAAPABQDASIAAhEBAxEB\u002F8QAFgABAQEAAAAAAAAAAAAAAAAABgAH\u002F8QAHxAAAQQCAwEBAAAAAAAAAAAAAQIDBAUAEQYSIVEx\u002F8QAFgEBAQEAAAAAAAAAAAAAAAAABQME\u002F8QAGxEAAgMAAwAAAAAAAAAAAAAAAQIAAxEEBVH\u002F2gAMAwEAAhEDEQA\u002FAG\u002FHqlmbMbYo3EszHGi71dSddN6\u002FcRnhV84Oj8mIWleKA+YgoGVwqqMITbaUJSUgkDf79xAwZCg2pb6R9HXILSpAit3Y3LYwGZvkw++qaums3IUlpanUAElJ89yxjzKqhSr9915G1kDZ3lmZkwkCNU8gNWpbdyf\u002F2Q==","real close.svg","0|10m5s5:",[870,882],"The Complete Guide to Close: Chapter 7",{"createdAt":884,"description":885,"image":886,"noindex":30,"title":882,"updatedAt":889},"2026-04-29T18:51:02Z","See how finance teams use Nominal's autonomous agents for real-time consolidation and intercompany eliminations. Real insights from Leanpay's transformation.",{"alt":9,"altText":870,"asset":887,"bgColor":873,"caption":9,"dimensions":888,"lqip":878,"originalFilename":879},{"_ref":872,"_type":13},{"_type":16,"aspectRatio":875,"height":876,"width":877},"2026-09-09T10:58:41Z","\u002Fresources\u002Fclose-guide-chapter7",{"cta":892,"enabled":59,"headline":895},{"link":893,"text":252},{"linkPageModule":30,"newTab":30,"page":894,"type":34,"url":9},{"slug":251,"title":252},"Move from doing the work to running the business.",{"alt":9,"altText":870,"asset":897,"bgColor":873,"caption":9,"dimensions":898,"lqip":878,"originalFilename":879},{"_ref":872,"_type":13},{"_type":16,"aspectRatio":875,"height":876,"width":877}]