:30,"page":349,"type":34,"url":9},{"slug":169,"title":170},{"_key":351,"_type":28,"link":352,"text":176},"37977fbb53f2",{"linkPageModule":30,"newTab":30,"page":353,"type":34,"url":9},{"slug":175,"title":176},{"_key":355,"_type":28,"link":356,"text":182},"ce7211bbdf06",{"linkPageModule":30,"newTab":30,"page":357,"type":34,"url":9},{"slug":181,"title":182},{"_key":359,"_type":28,"link":360,"text":189},"c2cf79578089",{"linkPageModule":30,"newTab":30,"page":361,"type":34,"url":9},{"slug":188,"title":189},{"_key":363,"_type":28,"link":364,"text":158},"aa5c056f571d",{"linkPageModule":30,"newTab":30,"page":365,"type":34,"url":9},{"slug":157,"title":158},"By ERP","Solutions",{"_key":369,"_type":261,"children":370,"hasChildren":59,"hasComplex":30,"hasSubGroups":30,"label":117},"3ed1e90daf42",[371,375,379,383],{"_key":372,"_type":28,"link":373,"text":103},"ccdb6f145286",{"linkPageModule":30,"newTab":30,"page":374,"type":34,"url":9},{"slug":102,"title":103},{"_key":376,"_type":28,"link":377,"text":110},"8b88bd492913",{"linkPageModule":30,"newTab":30,"page":378,"type":34,"url":9},{"slug":109,"title":110},{"_key":380,"_type":28,"link":381,"text":116},"543fda435ee0",{"linkPageModule":30,"newTab":30,"page":382,"type":34,"url":9},{"slug":115,"title":116},{"_key":384,"_type":28,"link":385,"text":148},"d668686708d7",{"linkPageModule":30,"newTab":30,"page":386,"type":34,"url":9},{"slug":146,"title":147},{"_key":388,"_type":261,"children":389,"hasChildren":59,"hasComplex":30,"hasSubGroups":59,"label":224},"ec3c9c96a73a",[390,412],{"_key":391,"_type":320,"children":392,"label":411},"7f3f46db00b2",[393,397,401,405],{"_key":394,"_type":28,"link":395,"text":199},"91346855e74b",{"linkPageModule":30,"newTab":30,"page":396,"type":34,"url":9},{"slug":198,"title":9},{"_key":398,"_type":28,"link":399,"text":205},"73e52b9d612e",{"linkPageModule":30,"newTab":30,"page":400,"type":34,"url":9},{"slug":204,"title":9},{"_key":402,"_type":28,"link":403,"text":211},"6039453eeab9",{"linkPageModule":30,"newTab":30,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"blockText":427,"formRef":9,"globalSeo":660,"headerImage":661,"next":672,"publishedDate":744,"searchTerms":745,"seo":748,"slug":754,"title":746},"LQIXpVyMC2AzA4WEYoetJr","2NP1OABzpWPzKX7lI2CX3U","pressEntry",[428,458,467,475,483,491,499,507,515,523,531,550,569,577,585,593,602,610,618,626,656],{"_key":429,"_type":430,"children":431,"markDefs":451,"style":457},"9a2c422085f9","toolbar",[432,438,442,447],{"_key":433,"_type":434,"marks":435,"text":437},"H8kwPCvBTRwrcP7zkSUyoR","span",[436],"6bb88e45-a097-4dd9-8a6f-3bc5b1ca17d5","Nominal",{"_key":439,"_type":434,"marks":440,"text":441},"H8kwPCvBTRwrcP7zkSUyp3",[]," has been named to The Agentic List 2026, a recognition identifying the 120 most promising private companies building enterprise-grade agentic AI. The list is presented in partnership with NYSE Wired and theCUBE, featured as part of the ",{"_key":443,"_type":434,"marks":444,"text":446},"H8kwPCvBTRwrcP7zkSUypf",[445],"87b4077e-46d7-4c84-bf48-37bf4e5817e4","AI Agent Conference 2026",{"_key":448,"_type":434,"marks":449,"text":450},"H8kwPCvBTRwrcP7zkSUyqH",[],".",[452,455],{"_key":436,"_type":453,"linkPageModule":9,"newTab":30,"page":9,"type":124,"url":454},"link","https:\u002F\u002Fnominal.so\u002F",{"_key":445,"_type":453,"linkPageModule":9,"newTab":30,"page":9,"type":124,"url":456},"https:\u002F\u002Fwww.agentconference.com\u002F","normal",{"_key":459,"_type":430,"children":460,"markDefs":465,"style":466},"9cad6f8a3280",[461],{"_key":462,"_type":434,"marks":463,"text":464},"H8kwPCvBTRwrcP7zkSUyqt",[],"What The Agentic List Recognizes",[],"h2",{"_key":468,"_type":430,"children":469,"markDefs":474,"style":457},"b1e86f014727",[470],{"_key":471,"_type":434,"marks":472,"text":473},"H8kwPCvBTRwrcP7zkSUyrV",[],"The Agentic List 2026 was built to cut through the noise in a fast-moving market. Selection is driven entirely by merit: executive nominations, enterprise adoption signals, and independent research, not sponsorship or visibility.",[],{"_key":476,"_type":430,"children":477,"markDefs":482,"style":457},"dbcc01c508b9",[478],{"_key":479,"_type":434,"marks":480,"text":481},"H8kwPCvBTRwrcP7zkSUys7",[],"The process began with an open nominations phase that drew over 5,000 entries from enterprise executives, investors, and industry operators. From there, nearly 2,000 private companies were screened across five dimensions: product maturity, enterprise adoption, competitive differentiation, growth momentum, and funding trajectory.",[],{"_key":484,"_type":430,"children":485,"markDefs":490,"style":457},"bf2bf77b836b",[486],{"_key":487,"_type":434,"marks":488,"text":489},"H8kwPCvBTRwrcP7zkSUysj",[],"Industry adoption and executive validation carried the heaviest weight throughout the evaluation. The list is designed to reflect what is working in production environments, not what generates the most visibility. Final selections were organized across three themes: Agentic Enterprises, Agentic Engineering, and Agentic Industries.",[],{"_key":492,"_type":430,"children":493,"markDefs":498,"style":466},"69be5d83c52a",[494],{"_key":495,"_type":434,"marks":496,"text":497},"H8kwPCvBTRwrcP7zkSUytL",[],"Nominal's Recognition: Finance & Operations Agents",[],{"_key":500,"_type":430,"children":501,"markDefs":506,"style":457},"236a9e729683",[502],{"_key":503,"_type":434,"marks":504,"text":505},"H8kwPCvBTRwrcP7zkSUytx",[],"Nominal was recognized under the Agentic Enterprises theme, in the Finance & Operations Agents category, defined as AI agents automating financial processes, forecasting, and operational workflows.",[],{"_key":508,"_type":430,"children":509,"markDefs":514,"style":457},"04b44366444f",[510],{"_key":511,"_type":434,"marks":512,"text":513},"H8kwPCvBTRwrcP7zkSUyuZ",[],"The recognition reflects a simple but significant shift in how finance operations run. Most automation tools assist humans in working faster. Nominal's agents do the work itself. Intelligent systems that handle reconciliation, consolidation, close management, and flux analysis across every entity, with little to no manual intervention. Finance teams move from processing transactions to managing performance.",[],{"_key":516,"_type":430,"children":517,"markDefs":522,"style":457},"1717dc868dce",[518],{"_key":519,"_type":434,"marks":520,"text":521},"H8kwPCvBTRwrcP7zkSUyvB",[],"This distinction matters to enterprise leaders evaluating agentic AI. Assistance still leaves humans in the execution path. Execution removes them from it entirely, allowing finance to operate like reliable infrastructure rather than a resource-constrained function perpetually struggling to keep pace.",[],{"_key":524,"_type":430,"children":525,"markDefs":530,"style":466},"6bb3a1bf58d8",[526],{"_key":527,"_type":434,"marks":528,"text":529},"H8kwPCvBTRwrcP7zkSUyvn",[],"The Framework Behind the Recognition: Agentic Performance Management",[],{"_key":532,"_type":430,"children":533,"markDefs":547,"style":457},"6f277ed23187",[534,538,543],{"_key":535,"_type":434,"marks":536,"text":537},"H8kwPCvBTRwrcP7zkSUywP",[],"The recognition reflects the growing enterprise adoption of ",{"_key":539,"_type":434,"marks":540,"text":542},"H8kwPCvBTRwrcP7zkSUyx1",[541],"bcf62cb3-9253-43d4-a35f-59e30d13aa90","Agentic Performance Management (APM)",{"_key":544,"_type":434,"marks":545,"text":546},"H8kwPCvBTRwrcP7zkSUyxd",[],", the operational framework at the core of the platform. This is not a tool or feature set. It is a new model for how finance organizations run.",[548],{"_key":541,"_type":453,"linkPageModule":9,"newTab":30,"page":9,"type":124,"url":549},"https:\u002F\u002Fnominal.so\u002Fblog\u002Fagentic-performance-management",{"_key":551,"_type":430,"children":552,"markDefs":566,"style":457},"3e8755662898",[553,557,562],{"_key":554,"_type":434,"marks":555,"text":556},"H8kwPCvBTRwrcP7zkSUyyF",[],"Under APM, ",{"_key":558,"_type":434,"marks":559,"text":561},"H8kwPCvBTRwrcP7zkSUyyr",[560],"5d44dc30-0aeb-4419-a776-716ab0d28558","autonomous agents",{"_key":563,"_type":434,"marks":564,"text":565},"H8kwPCvBTRwrcP7zkSUyzT",[]," own complete workflows from start to finish. They validate transactions, identify discrepancies, execute reconciliations, prepare eliminations, and close the books without waiting for instructions. When exceptions occur, they apply logic based on context and historical behavior, escalating only what genuinely requires professional judgment.",[567],{"_key":560,"_type":453,"linkPageModule":9,"newTab":30,"page":9,"type":124,"url":568},"https:\u002F\u002Fnominal.so\u002Fblog\u002Fautonomous-agents-finance",{"_key":570,"_type":430,"children":571,"markDefs":576,"style":457},"9c0e849f395f",[572],{"_key":573,"_type":434,"marks":574,"text":575},"H8kwPCvBTRwrcP7zkSUz05",[],"The human role does not disappear. It evolves. Controllers and CFOs govern outcomes rather than managing every step. Accountants focus on analysis, strategy, and decision support instead of manual execution. The result is a finance function that scales with business complexity rather than against it.",[],{"_key":578,"_type":430,"children":579,"markDefs":584,"style":466},"f6ae3379c928",[580],{"_key":581,"_type":434,"marks":582,"text":583},"H8kwPCvBTRwrcP7zkSUz0h",[],"Recognition Across Three Stages",[],{"_key":586,"_type":430,"children":587,"markDefs":592,"style":457},"5b0698a186a5",[588],{"_key":589,"_type":434,"marks":590,"text":591},"H8kwPCvBTRwrcP7zkSUz1J",[],"The Agentic List distinguishes companies across three funding stages. Nominal was recognized at the Early Stage tier, defined as companies demonstrating strong product-market fit and early enterprise traction with autonomous AI capabilities, a profile that reflects proven deployment in production environments and clear momentum toward category leadership.",[],{"_key":594,"_type":430,"children":595,"markDefs":600,"style":601},"3c2f093f9f63",[596],{"_key":597,"_type":434,"marks":598,"text":599},"H8kwPCvBTRwrcP7zkSUz1v",[],"What This Means for Finance Teams",[],"h3",{"_key":603,"_type":430,"children":604,"markDefs":609,"style":457},"2a96e8c4e180",[605],{"_key":606,"_type":434,"marks":607,"text":608},"H8kwPCvBTRwrcP7zkSUz2X",[],"Agentic AI is no longer a forward-looking concept. Enterprise leaders are actively evaluating, piloting, and deploying these systems. The companies on this list are the ones generating real, repeatable impact in production. Selection was driven by first-hand enterprise signals, not marketing visibility.",[],{"_key":611,"_type":430,"children":612,"markDefs":617,"style":457},"e157e058660f",[613],{"_key":614,"_type":434,"marks":615,"text":616},"H8kwPCvBTRwrcP7zkSUz39",[],"For finance teams, the implications are concrete. Manual work grows linearly. Agentic systems scale exponentially. Organizations can support new entities and markets without adding headcount, close the books faster without extending deadlines, and give finance professionals the capacity to focus on what actually moves the business forward.",[],{"_key":619,"_type":430,"children":620,"markDefs":625,"style":457},"0afad4dae2a1",[621],{"_key":622,"_type":434,"marks":623,"text":624},"H8kwPCvBTRwrcP7zkSUz3l",[],"Nominal's inclusion in The Agentic List 2026 reflects that momentum. Intelligent agents are executing the work that once required entire teams to manage manually. The result is a finance function that scales with the business, not against it.",[],{"_key":627,"_type":430,"children":628,"markDefs":651,"style":457},"7bab8c87c3fc",[629,633,638,642,647],{"_key":630,"_type":434,"marks":631,"text":632},"H8kwPCvBTRwrcP7zkSUz4N",[],"The ",{"_key":634,"_type":434,"marks":635,"text":637},"H8kwPCvBTRwrcP7zkSUz4z",[636],"e99e6ebf-0b50-44e8-8e29-6d5abc64fe38","full Agentic List 2026",{"_key":639,"_type":434,"marks":640,"text":641},"H8kwPCvBTRwrcP7zkSUz5b",[]," is available here. Ready to see autonomous agents in action?",{"_key":643,"_type":434,"marks":644,"text":646},"H8kwPCvBTRwrcP7zkSUz6D",[645],"005a32df-1c54-4f05-a2ca-55e1866beec8"," Book a demo",{"_key":648,"_type":434,"marks":649,"text":650},"H8kwPCvBTRwrcP7zkSUz6p",[]," and talk to the team about how Nominal transforms finance operations from the ground up.",[652,654],{"_key":636,"_type":453,"linkPageModule":9,"newTab":30,"page":9,"type":124,"url":653},"https:\u002F\u002Fwww.agentconference.com\u002Fagenticlist\u002F2026",{"_key":645,"_type":453,"linkPageModule":9,"newTab":30,"page":9,"type":124,"url":655},"https:\u002F\u002Fnominal.so\u002Fbook-a-demo?utm_medium=organic&utm_source=blog&utm_campaign=book-demo-blog](https:\u002F\u002Fwww.nominal.so\u002Fbook-a-demo?utm_medium=organic&utm_source=blog&utm_campaign=book-demo-blog",{"_key":657,"_type":658,"fullWidth":9,"htmlCode":659,"label":9,"markDefs":9},"f576ea51f386","htmlEmbed","\u003C!--HubSpot Call-to-Action Code -->\u003Cspan class=\"hs-cta-wrapper\" id=\"hs-cta-wrapper-4b82ac39-11e7-4900-8102-39e752d0a322\">\u003Cspan class=\"hs-cta-node hs-cta-4b82ac39-11e7-4900-8102-39e752d0a322\" id=\"hs-cta-4b82ac39-11e7-4900-8102-39e752d0a322\">\u003C!--[if lte IE 8]>\u003Cdiv id=\"hs-cta-ie-element\">\u003C\u002Fdiv>\u003C![endif]-->\u003Ca href=\"https:\u002F\u002Fcta-redirect.hubspot.com\u002Fcta\u002Fredirect\u002F48589798\u002F4b82ac39-11e7-4900-8102-39e752d0a322\" target=\"_blank\" rel=\"noopener\">\u003Cimg class=\"hs-cta-img\" id=\"hs-cta-img-4b82ac39-11e7-4900-8102-39e752d0a322\