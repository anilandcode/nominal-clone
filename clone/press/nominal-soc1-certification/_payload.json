ewTab":30,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"blockText":427,"formRef":9,"globalSeo":575,"headerImage":576,"next":587,"publishedDate":634,"searchTerms":635,"seo":639,"slug":647,"title":636},"LQIXpVyMC2AzA4WEYoetD2","3bN0u7cRgjo3Xnr4MixtRU","pressEntry",[428,439,447,467,475,483,488,507,515,530,537,540,548,556,564],{"_key":429,"_type":430,"children":431,"markDefs":437,"style":438},"c68918105677","toolbar",[432],{"_key":433,"_type":434,"marks":435,"text":436},"Bx4XY85DZiUPiPe8LD93Vv","span",[],"April 1, 2025 – New York, New York",[],"normal",{"_key":440,"_type":430,"children":441,"markDefs":446,"style":438},"c3d2ae60dca7",[442],{"_key":443,"_type":434,"marks":444,"text":445},"Bx4XY85DZiUPiPe8LD93ZM",[],"Nominal, the AI-powered financial operations platform transforming how businesses manage consolidation, compliance, and close, today announced it has successfully completed its System and Organization Controls (SOC) 1 Type II certification.",[],{"_key":448,"_type":430,"children":449,"markDefs":463,"style":438},"e51d707fbdb9",[450,454,459],{"_key":451,"_type":434,"marks":452,"text":453},"Bx4XY85DZiUPiPe8LD93jf",[],"As one of the first startups building autonomous financial workflows to achieve this milestone, Nominal is setting a new industry standard for trust and accountability in ",{"_key":455,"_type":434,"marks":456,"text":458},"Bx4XY85DZiUPiPe8LD93n6",[457],"3433ca3c-2381-425e-9f53-5c658ab1f541","agentic AI",{"_key":460,"_type":434,"marks":461,"text":462},"Bx4XY85DZiUPiPe8LD93qX",[],".",[464],{"_key":457,"_type":465,"linkPageModule":9,"newTab":30,"page":9,"type":124,"url":466},"link","https:\u002F\u002Fnominal.so\u002Fblog\u002Funderstanding-agentic-ai-the-new-generation-of-artificial-intelligence",{"_key":468,"_type":430,"children":469,"markDefs":474,"style":438},"81b18d519989",[470],{"_key":471,"_type":434,"marks":472,"text":473},"Bx4XY85DZiUPiPe8LD93ty",[],"SOC 1 compliance, developed by the American Institute of Certified Public Accountants (AICPA), evaluates the design and implementation of internal controls over financial reporting.",[],{"_key":476,"_type":430,"children":477,"markDefs":482,"style":438},"7704c42b7507",[478],{"_key":479,"_type":434,"marks":480,"text":481},"Bx4XY85DZiUPiPe8LD93xP",[],"The independent audit validates that Nominal’s controls are not only robust but purpose-built to meet the complex demands of AI-driven finance.",[],{"_key":484,"_type":485,"citation":486,"markDefs":9,"text":487},"9cdd86193dd3","blockquote","","“From day one, our mission at Nominal has been to bring clarity and control to the complex world of financial operations,” said Guy Leibovitz, CEO and Co-founder of Nominal. “As one of the first agentic AI platforms to achieve SOC 1 compliance, this milestone reinforces the trust our customers place in us to operate with both intelligence and integrity.”",{"_key":489,"_type":430,"children":490,"markDefs":504,"style":438},"ee03ca9bde1d",[491,495,500],{"_key":492,"_type":434,"marks":493,"text":494},"Bx4XY85DZiUPiPe8LD940q",[],"Nominal’s platform doesn’t just automate—it acts. With agentic AI that executes ",{"_key":496,"_type":434,"marks":497,"text":499},"Bx4XY85DZiUPiPe8LD944H",[498],"21d5243c-529a-49a4-b79e-4924658d1f44","accounting workflows autonomously",{"_key":501,"_type":434,"marks":502,"text":503},"Bx4XY85DZiUPiPe8LD947i",[],", security isn’t a feature