,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"blockText":427,"categories":489,"customLabel":9,"eventDate":497,"eventLocation":498,"eventType":9,"formRef":499,"globalSeo":506,"headerImage":507,"pageModules":9,"peopleList":518,"peopleTitle":9,"searchTerms":545,"seo":547,"slug":554,"sock":555,"startTime":9,"title":546},"07Tz8UWJnMcGO2oGCZ3PPb","cAAm1ea55llPFOka1V5qVq","eventEntry",[428,439,448,457,465,473,481],{"_key":429,"_type":430,"children":431,"markDefs":437,"style":438},"7de8a7edc3b9","toolbar",[432],{"_key":433,"_type":434,"marks":435,"text":436},"PCI4OCibo2k6ZTKIaydkVz","span",[],"You implemented a modern ERP. Your team is still consolidating in Excel, manually matching intercompany entries, and exporting data to reconcile. Learn how finance teams are closing this execution gap with Agentic Performance Management (APM).",[],"normal",{"_key":440,"_type":430,"children":441,"markDefs":446,"style":447},"0edfa35b228b",[442],{"_key":443,"_type":434,"marks":444,"text":445},"PCI4OCibo2k6ZTKIaydkY9",[],"What You Will Learn",[],"h4",{"_key":449,"_type":430,"children":450,"level":17,"listItem":455,"markDefs":456,"style":438},"668eee77e62a",[451],{"_key":452,"_type":434,"marks":453,"text":454},"PCI4OCibo2k6ZTKIaydkaJ",[],"Why the execution gap exists: ERPs excel as systems of record but weren't designed to autonomously execute complex workflows like consolidations or intercompany eliminations.","bullet",[],{"_key":458,"_type":430,"children":459,"level":17,"listItem":455,"markDefs":464,"style":438},"c406225ff30e",[460],{"_key":461,"_type":434,"marks":462,"text":463},"PCI4OCibo2k6ZTKIaydked",[],"What Agentic Performance Management (APM): The execution layer that sits between your ERP and your finance team, using AI agents that execute complete workflows with your oversight.",[],{"_key":466,"_type":430,"children":467,"level":17,"listItem":455,"markDefs":472,"style":438},"a26274ee8152",[468],{"_key":469,"_type":434,"marks":470,"text":471},"PCI4OCibo2k6ZTKIaydkix",[],"How AI agents automate manual work: See how agents handle consolidations across entities, match and eliminate intercompany transactions, and execute reconciliations.",[],{"_key":474,"_type":430,"children":475,"level":17,"listItem":455,"markDefs":480,"style":438},"a121fcdba018",[476],{"_key":477,"_type":434,"marks":478,"text":479},"PCI4OCibo2k6ZTKIaydknH",[],"Real results from finance teams: One company reduced their reconciliation team from 4 people to 1. Others cut close time from 10 days to 3.",[],{"_key":482,"_type":430,"children":483,"markDefs":488,"style":438},"9d4f5f343448",[484],{"_key":485,"_type":434,"marks":486,"text":487},"PCI4OCibo2k6ZTKIaydkrb",[],"Finance teams with 5+ entities spend 60% of their time on execution, not analysis. APM flips that ratio.",[],[490],{"_id":491,"group":492,"slug":493,"title":496},"PCI4OCibo2k6ZTKIaybmvP","event-category",{"_type":494,"current":495},"slug","webinars","Webinars","2026-01-27","11:00 AM",{"_id":500,"_type":501,"blockText":9,"formId":502,"portalId":503,"region":504,"title":505},"PCI4OCibo2k6ZTKIayc6aN","form","0a7904d8-b0ca-45a9-a410-ec04270c6fd1","48589798","na1","Event Form - The Finance Operations Layer Your ERP Wasn't Built For",{"description":9,"image":9,"title":9},{"alt":9,"altText":508,"asset":509,"bgColor":511,"caption":9,"dimensions":512,"lqip":516,"originalFilename":517},"Nominal webinar cove