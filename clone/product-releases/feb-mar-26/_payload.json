:30,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"blockText":427,"globalSeo":822,"intro":823,"orderRank":824,"seo":9,"slug":825,"sock":826,"title":831},"4ffabdf2-5f13-4082-957e-2ac51271545e","IDnnpmMaiLN3sSgwb9V214","productReleaseEntry",[428,439,448,461,469,477,486,494,502,510,518,526,534,542,550,558,566,574,582,590,598,606,614,622,630,638,646,654,662,670,678,686,694,702,710,718,726,734,742,750,758,766,774,782,790,798,806,814],{"_key":429,"_type":430,"children":431,"markDefs":437,"style":438},"bc6f1353cccd","toolbar",[432],{"_key":433,"_type":434,"marks":435,"text":436},"77d17f5f526a","span",[],"Knowledge Base — Now Live",[],"h2",{"_key":440,"_type":430,"children":441,"markDefs":446,"style":447},"c2f62c41f6ae",[442],{"_key":443,"_type":434,"marks":444,"text":445},"ac1240702b18",[],"Nominal's Knowledge Base is now live: a growing library of how-tos, reference docs, and step-by-step articles to help your team get the most out of the platform.",[],"normal",{"_key":449,"_type":430,"children":450,"level":17,"listItem":456,"markDefs":457,"style":447},"2af82e0cf4a6",[451],{"_key":452,"_type":434,"marks":453,"text":455},"0e936de5987d",[454],"4dceda14-7a04-4d25-83f7-e0d158beb3a3","nominal-1-knowledge-base.help.usepylon.com","bullet",[458],{"_key":454,"_type":459,"linkPageModule":9,"newTab":59,"page":9,"type":124,"url":460},"link","https:\u002F\u002Fnominal-1-knowledge-base.help.usepylon.com\u002F",{"_key":462,"_type":430,"children":463,"markDefs":468,"style":438},"dbb7765d13ab",[464],{"_key":465,"_type":434,"marks":466,"text":467},"704154f6f46e",[],"Transaction Patrol",[],{"_key":470,"_type":430,"children":471,"markDefs":476,"style":447},"816c1e34f0f5",[472],{"_key":473,"_type":434,"marks":474,"text":475},"5b107de641e5",[],"Patrol got smarter, faster, and more tailored to how your team actually works.",[],{"_key":478,"_type":430,"children":479,"markDefs":484,"style":485},"331e12f4d057",[480],{"_key":481,"_type":434,"marks":482,"text":483},"0e3974bb01bf",[],"Optimized Alert Lifecycle",[],"h3",{"_key":487,"_type":430,"children":488,"markDefs":493,"style":447},"e05a7e7f0b00",[489],{"_key":490,"_type":434,"marks":491,"text":492},"92f425547bab",[],"Alerts are now automatically re-evaluated as new data comes in. Stale alerts no longer pile up; the system resolves or escalates them based on current conditions.",[],{"_key":495,"_type":430,"children":496,"markDefs":501,"style":485},"82e938a5a31d",[497],{"_key":498,"_type":434,"marks":499,"text":500},"ff2ae80bd8e9",[],"Agent Accuracy Improvements",[],{"_key":503,"_type":430,"children":504,"markDefs":509,"style":447},"b00451257337",[505],{"_key":506,"_type":434,"marks":507,"text":508},"b7ccc0088bfe",[],"Nominal improved the prompts and logic powering all Patrol agents, making detection more precise and reducing noise across the board.",[],{"_key":511,"_type":430,"children":512,"markDefs":517,"style":485},"7164b4b32b3c",[513],{"_key":514,"_type":434,"marks":515,"text":516},"09bba621feb8",[],"Patrol Learns from Your Dismissals",[],{"_key":519,"_type":430,"children":520,"markDefs":525,"style":447},"2c912d4d9b48",[521],{"_key":522,"_type":434,"marks":523,"text":524},"9bdece325d94",[],"When you dismiss an alert and provide a reason, Patrol uses that input to update the agent's understanding of what's acceptable for your business. It stops flagging things you've already told it don't matter. This learning is unique per-customer and per-agent, and it gets more accurate over time.",[],{"_key":527,"_type":430,"children":528,"markDefs":533,"style":438},"00c1c6c1b552",[529],{"_key":530,"_type":434,"marks":531,"text":532},"1c55113b5c0b",[],"Close Management",[],{"_key":535,"_type":430,"children":536,"markDefs":541,"style":447},"25fa336b47fc",[537],{"_key":538,"_type":434,"marks":539,"text":540},"342272f16db7",[],"A focused set of improvements to make the Close experience cleaner, faster, and easier to manage across entities.",[],{"_key":543,"_type":430,"children":544,"markDefs":549,"style":485},"585a22ec8e85",[545],{"_key":546,"_type":434,"marks":547,"text":548},"2cd4d2bf389b",[],"Bulk Actions",[],{"_key":551,"_type":430,"children":552,"markDefs":557,"style":447},"e2e7e8f58897",[553],{"_key":554,"_type":434,"marks":555,"text":556},"d01c71b25270",[],"Take action on multiple tasks at once: update statuses, reassign, or resolve in bulk. Changes can also be applied to future recurring tasks, not just the current period.",[],{"_key":559,"_type":430,"children":560,"markDefs":565,"style":485},"9be3b8c88fbc",[561],{"_key":562,"_type":434,"marks":563,"text":564},"6970c49f604c",[],"Redesigned Due Dates",[],{"_key":567,"_type":430,"children":568,"markDefs":573,"style":447},"ac06a3d08938",[569],{"_key":570,"_type":434,"marks":571,"text":572},"ee89e7f0e4e9",[],"The due date experience has been overhauled to make it clearer and more straightforward to configure.",[],{"_key":575,"_type":430,"children":576,"markDefs":581,"style":485},"d12b1b03b8ab",[577],{"_key":578,"_type":434,"marks":579,"text":580},"769f91350481",[],"Clearer Activity Statuses",[],{"_key":583,"_type":430,"children":584,"markDefs":589,"style":447},"d772daee23c5",[585],{"_key":586,"_type":434,"marks":587,"text":588},"de1ba1a27c1b",[],"\"Not Started\" and \"In Progress\" now replace the previous \"On Track\" labels, language that better reflects what's actually happening in the close.",[],{"_key":591,"_type":430,"children":592,"markDefs":597,"style":485},"d9cdc94cc514",[593],{"_key":594,"_type":434,"marks":595,"text":596},"9afe1d371671",[],"Revert Task Status from the Table",[],{"_key":599,"_type":430,"children":600,"markDefs":605,"style":447},"c0b00f455dcb",[601],{"_key":602,"_type":434,"marks":603,"text":604},"fc7f5d0b130c",[],"You can now revert a task's last status change directly from the 3-dot menu in the task list, without opening the task. Permissions apply: preparers can only revert within their own scope.",[],{"_key":607,"_type":430,"children":608,"markDefs":613,"style":485},"b9659a4b42e7",[609],{"_key":610,"_type":434,"marks":611,"text":612},"7f19ea93f906",[],"Smarter Filters",[],{"_key":615,"_type":430,"children":616,"markDefs":621,"style":447},"b258aba010f5",[617],{"_key":618,"_type":434,"marks":619,"text":620},"fa5a1118a3fe",[],"Filters no longer show statuses that don't exist in the current view. Less noise, cleaner navigation.",[],{"_key":623,"_type":430,"children":624,"markDefs":629,"style":485},"c089a9128902",[625],{"_key":626,"_type":434,"marks":627,"text":628},"41f9d4dfa593",[],"Group by Subsidiaries",[],{"_key":631,"_type":430,"children":632,"markDefs":637,"style":447},"c75f031ba5ca",[633],{"_key":634,"_type":434,"marks":635,"text":636},"2444f13334b0",[],"The Tasks page now includes a group-by-subsidiaries option, making it easier to track close progress across your entity structure.",[],{"_key":639,"_type":430,"children":640,"markDefs":645,"style":485},"666761712e2a",[641],{"_key":642,"_type":434,"marks":643,"text":644},"f55498e2f743",[],"Save Filter Presets",[],{"_key":647,"_type":430,"children":648,"markDefs":653,"style":447},"2c7cb4c23e09",[649],{"_key":650,"_type":434,"marks":651,"text":652},"3c1e78b7e376",[],"Save named filter configurations and reapply them in one click.",[],{"_key":655,"_type":430,"children":656,"markDefs":661,"style":485},"86f6b3425eb4",[657],{"_key":658,"_type":434,"marks":659,"text":660},"aff174cd4cbb",[],"Task Status Enhancements",[],{"_key":663,"_type":430,"children":664,"markDefs":669,"style":447},"70c6ec271229",[665],{"_key":666,"_type":434,"marks":667,"text":668},"117d1a190ae5",[],"The task list received a visual overhaul. A new color-coded status badge now appears as the first column for faster scanning (To Do, In Review, Done, Declined). The progress indicator reflects each status visually, attachment and comment counts are shown inline on each row, and subsidiary names are displayed in full instead of initials.",[],{"_key":671,"_type":430,"children":672,"markDefs":677,"style":438},"a4db85093922",[673],{"_key":674,"_type":434,"marks":675,"text":676},"7c62b5361a64",[],"Flux Analysis",[],{"_key":679,"_type":430,"children":680,"markDefs":685,"style":447},"bd7b0ac53920",[681],{"_key":682,"_type":434,"marks":683,"text":684},"bd80874fbde6",[],"Nominal is mid-cycle on a set of major Flux improvements. Here is what is already live.",[],{"_key":687,"_type":430,"children":688,"markDefs":693,"style":485},"f7eea40ecc4a",[689],{"_key":690,"_type":434,"marks":691,"text":692},"3e271b9e7d8f",[],"Per-Account Regeneration",[],{"_key":695,"_type":430,"children":696,"markDefs":701,"style":447},"778b5b73e6fa",[697],{"_key":698,"_type":434,"marks":699,"text":700},"d3fc7f869395",[],"Regenerate flux explanations for individual accounts without re-running everything. Choose Quick mode for speed or Deep mode for a more thorough analysis.",[],{"_key":703,"_type":430,"children":704,"markDefs":709,"style":485},"be8a046e8806",[705],{"_key":706,"_type":434,"marks":707,"text":708},"6cf8c9f961b2",[],"Stale Explanation Indicator",[],{"_key":711,"_type":430,"children":712,"markDefs":717,"style":447},"c4126508bc8e",[713],{"_key":714,"_type":434,"marks":715,"text":716},"944eb4361840",[],"If the GL is updated after an account has already been explained or approved, Flux automatically flags that explanation as potentially outdated, so your team always knows which accounts need a second look.",[],{"_key":719,"_type":430,"children":720,"markDefs":725,"style":485},"b3b8ee1d7094",[721],{"_key":722,"_type":434,"marks":723,"text":724},"02e71b6bcb99",[],"Main Drivers First in Drill-Down",[],{"_key":727,"_type":430,"children":728,"markDefs":733,"style":447},"40b040163ea3",[729],{"_key":730,"_type":434,"marks":731,"text":732},"edf011c1f571",[],"The drill-down table now surfaces the biggest variance drivers at the top, so you get to the signal faster.",[],{"_key":735,"_type":430,"children":736,"markDefs":741,"style":485},"6ab5754abaa4",[737],{"_key":738,"_type":434,"marks":739,"text":740},"c0a9ddc7e3e8",[],"Monthly and Quarterly Year-over-Year Comparisons",[],{"_key":743,"_type":430,"children":744,"markDefs":749,"style":447},"50c13b852f23",[745],{"_key":746,"_type":434,"marks":747,"text":748},"711c747fe627",[],"Flux now supports both monthly and quarterly year-over-year comparison views, giving accounting teams more flexibility in how they analyze period performance.",[],{"_key":751,"_type":430,"children":752,"markDefs":757,"style":438},"1aacce1ebf79",[753],{"_key":754,"_type":434,"marks":755,"text":756},"bac114aead4a",[],"Coming Soon",[],{"_key":759,"_type":430,"children":760,"markDefs":765,"style":447},"cc5047a44b80",[761],{"_key":762,"_type":434,"marks":763,"text":764},"99be69368afd",[],"These features are mid-cycle and will be available before this release closes.",[],{"_key":767,"_type":430,"children":768,"markDefs":773,"style":485},"dc5c847fc405",[769],{"_key":770,"_type":434,"marks":771,"text":772},"d61b7cd119a6",[],"Last Report Run Indicator (Flux Analysis)",[],{"_key":775,"_type":430,"children":776,"markDefs":781,"style":447},"36a75bcd60dc",[777],{"_key":778,"_type":434,"marks":779,"text":780},"7da7a4e69a23",[],"You'll be able to see exactly when the last Flux report was run, shown in the top right corner of the report.",[],{"_key":783,"_type":430,"children":784,"markDefs":789,"style":485},"b4b19993cfdf",[785],{"_key":786,"_type":434,"marks":787,"text":788},"c03196e9dd75",[],"Period Selector Alignment (Close Management)",[],{"_key":791,"_type":430,"children":792,"markDefs":797,"style":447},"249e913d43e2",[793],{"_key":794,"_type":434,"marks":795,"text":796},"77fdd3e8e2e5",[],"A consistent period selector experience across Close Management views.",[],{"_key":799,"_type":430,"children":800,"markDefs":805,"style":485},"2165f8d8deb8",[801],{"_key":802,"_type":434,"marks":803,"text":804},"61c756f0a490",[],"Variance Threshold Configuration (Flux Analysis)",[],{"_key":807,"_type":430,"children":808,"markDefs":813,"style":447},"41560a196888",[809],{"_key":810,"_type":434,"marks":811,"text":812},"0e9011c9be97",[],"Configure variance thresholds directly from the UI. The backend is live; the UI is coming next cycle.",[],{"_key":815,"_type":430,"children":816,"markDefs":821,"style":447},"802d3f898309",[817],{"_key":818,"_type":434,"marks":819,"text":820},"9daf977300d0",[],"Have questions about any of these features? Reach out to your customer representative to learn more about how these capabilities can improve your close process.",[],{"description":9,"image":9,"title":9},"This release brings major improvements to Transaction Patrol, Close Management, and Flux Analysis, with a focus on precision, control, and speed across every stage of the close.","0|0r0006:","\u002Fproduct-releases\u002Ffeb-mar-26",{"cta":827,"enabled":59,"headline":830},{"link":828,"text":252},{"linkPageModule":30,"newTab":30,"page":829,"type":34,"url":9},{"slug":251,"title":252},"Move from doing the work to running the business.","Product Release February and March 2026"]