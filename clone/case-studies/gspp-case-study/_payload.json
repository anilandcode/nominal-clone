0509","Company Size","50 - 100 employees",{"_key":453,"_type":454,"items":455,"label":460},"ada356d63b4f","asideList",[456,457,458,459],"Financial Consolidation","Multi-Entity Management","Lease Automation","Close Management","Key Pain Points",[462,473,483,491,499,507,515,523,528,536,544,552,566,578,590,602,610,618,626,634,646,658,670,682,686,694,702,714,726,738,750,762,770,778,799],{"_key":463,"_type":464,"children":465,"markDefs":471,"style":472},"60a7bfc16704","toolbar",[466],{"_key":467,"_type":468,"marks":469,"text":470},"6c2f18763b6f","span",[],"At a glance",[],"h2",{"_key":474,"_type":464,"children":475,"level":17,"listItem":480,"markDefs":481,"style":482},"720cb8f5fbdf",[476],{"_key":477,"_type":468,"marks":478,"text":479},"7804090b0777",[],"Automated financial consolidation across 280+ entities","bullet",[],"normal",{"_key":484,"_type":464,"children":485,"level":17,"listItem":480,"markDefs":490,"style":482},"37cf495bc0c3",[486],{"_key":487,"_type":468,"marks":488,"text":489},"c41e1d41295d",[],"Managed 200+ transactions per month",[],{"_key":492,"_type":464,"children":493,"level":17,"listItem":480,"markDefs":498,"style":482},"938d1dc15dba",[494],{"_key":495,"_type":468,"marks":496,"text":497},"7e13dce5c827",[],"Handled 115+ leases with ASC 842 compliance",[],{"_key":500,"_type":464,"children":501,"level":17,"listItem":480,"markDefs":506,"style":482},"e96ba8997709",[502],{"_key":503,"_type":468,"marks":504,"text":505},"3bc7883c1e68",[],"Saved 60+ hours per month on financial processes",[],{"_key":508,"_type":464,"children":509,"level":17,"listItem":480,"markDefs":514,"style":482},"4f32dbcc060d",[510],{"_key":511,"_type":468,"marks":512,"text":513},"cbd05fd26669",[],"Streamlined month-end close process",[],{"_key":516,"_type":464,"children":517,"level":17,"listItem":480,"markDefs":522,"style":482},"182dd7d9bf7c",[518],{"_key":519,"_type":468,"marks":520,"text":521},"e1b0c07cca2b",[],"Improved real-time visibility for executive decision-making",[],{"_key":524,"_type":525,"citation":526,"markDefs":9,"text":527},"47abbf0fcf97","blockquote","Josh Ramos, Controller at GSPP","Consolidating financials across our solar project entities used to be a spreadsheet nightmare. Nominal automated intercompany eliminations and consolidated everything with a click, saving us countless hours and keeping our books audit-ready.",{"_key":529,"_type":464,"children":530,"markDefs":535,"style":472},"98f15448dfc5",[531],{"_key":532,"_type":468,"marks":533,"text":534},"9340a85ee7a4",[],"Excel limitations hindered growth and efficiency",[],{"_key":537,"_type":464,"children":538,"markDefs":543,"style":482},"8043c549c8d4",[539],{"_key":540,"_type":468,"marks":541,"text":542},"b95c75e28c98",[],"In 2023, Green Street Power Partners (GSPP) found itself grappling with the limitations of Excel for managing its complex financial operations. As a national solar energy developer with multiple funds, holding companies, and project entities, GSPP's corporate structure demanded a more sophisticated solution for financial management and reporting.",[],{"_key":545,"_type":464,"children":546,"markDefs":551,"style":482},"01376a5d4f83",[547],{"_key":548,"_type":468,"marks":549,"text":550},"ec794ca5c406",[],"The finance team faced significant challenges:",[],{"_key":553,"_type":464,"children":554,"level":17,"listItem":564,"markDefs":565,"style":482},"839c6ad04d56",[555,560],{"_key":556,"_type":468,"marks":557,"text":559},"7c867dc8c1fa",[558],"strong","Time-consuming consolidations",{"_key":561,"_type":468,"marks":562,"text":563},"ba6a6c08404f",[],": Monthly financial consolidations across numerous entities involved manual data entry and sprawling spreadsheets, taking days to complete.","number",[],{"_key":567,"_type":464,"children":568,"level":17,"listItem":564,"markDefs":577,"style":482},"7f26a5f1edc2",[569,573],{"_key":570,"_type":468,"marks":571,"text":572},"bafc83155d3d",[558],"Complex entity structure",{"_key":574,"_type":468,"marks":575,"text":576},"633e517349e1",[],": With over 280 entities, including LLCs, funds, and holding companies, managing intercompany eliminations was error-prone and inefficient.",[],{"_key":579,"_type":464,"children":580,"level":17,"listItem":564,"markDefs":589,"style":482},"7fb159bf732b",[581,585],{"_key":582,"_type":468,"marks":583,"text":584},"aff1536788bb",[558],"Lease accounting compliance",{"_key":586,"_type":468,"marks":587,"text":588},"94926b64a57e",[],": Manually tracking leases and ensuring compliance with ASC 842 standards was becoming increasingly difficult.",[],{"_key":591,"_type":464,"children":592,"level":17,"listItem":564,"markDefs":601,"style":482},"105bd390a932",[593,597],{"_key":594,"_type":468,"marks":595,"text":596},"332f16585b57",[558],"Inefficient month-end close",{"_key":598,"_type":468,"marks":599,"text":600},"0cae3eca7496",[],": The close process was stressful, time-consuming, and lacked visibility for stakeholders.",[],{"_key":603,"_type":464,"children":604,"markDefs":609,"style":482},"6043832fbb35",[605],{"_key":606,"_type":468,"marks":607,"text":608},"8369d10066bc",[],"Controller Josh Ramos described the situation: \"The complex entity structure meant consolidations took days of manual effort in spreadsheets. It was a constant struggle that cost us a significant amount of time and money. Efficiently consolidating reports and producing fund reports on a timely basis is a key factor for a company of our kind.\"",[],{"_key":611,"_type":464,"children":612,"markDefs":617,"style":472},"d62ad09b78a6",[613],{"_key":614,"_type":468,"marks":615,"text":616},"bad56275730e",[],"Nominal's AI-powered platform transforms financial operations",[],{"_key":619,"_type":464,"children":620,"markDefs":625,"style":482},"41c355ea798d",[621],{"_key":622,"_type":468,"marks":623,"text":624},"fbde4de15dea",[],"After evaluating various options, GSPP chose Nominal to revolutionize their critical finance workflows. Nominal's AI-powered automation and intuitive design stood out as the clear choice for addressing GSPP's complex needs.",[],{"_key":627,"_type":464,"children":628,"markDefs":633,"style":482},"295a0b812a08",[629],{"_key":630,"_type":468,"marks":631,"text":632},"8d04a1a6a580",[],"Key features that solved GSPP's challenges:",[],{"_key":635,"_type":464,"children":636,"level":17,"listItem":564,"markDefs":645,"style":482},"f5f4be7b5d0b",[637,641],{"_key":638,"_type":468,"marks":639,"text":640},"a3f2d9f8f295",[558],"Multi-entity consolidation",{"_key":642,"_type":468,"marks":643,"text":644},"618bf688e170",[],": Nominal effortlessly handled GSPP's complex hierarchies, automating intercompany eliminations and consolidations.",[],{"_key":647,"_type":464,"children":648,"level":17,"listItem":564,"markDefs":657,"style":482},"bcfcdb2e833b",[649,653],{"_key":650,"_type":468,"marks":651,"text":652},"324e1784f8c5",[558],"ASC 842 compliance",{"_key":654,"_type":468,"marks":655,"text":656},"67a71a3c1123",[],": Built-in lease management features streamlined compliance, automating lease tracking, bill creation, and reporting.",[],{"_key":659,"_type":464,"children":660,"level":17,"listItem":564,"markDefs":669,"style":482},"097717660b11",[661,665],{"_key":662,"_type":468,"marks":663,"text":664},"d0c97bfc8535",[558],"Collaborative close management",{"_key":666,"_type":468,"marks":667,"text":668},"9e42fc7963a6",[],": Centralized task lists, team communication, and reconciliations brought new levels of control and visibility to the close process.",[],{"_key":671,"_type":464,"children":672,"level":17,"listItem":564,"markDefs":681,"style":482},"5874097d5f2a",[673,677],{"_key":674,"_type":468,"marks":675,"text":676},"6302a8b86a5a",[558],"Real-time financial visibility",{"_key":678,"_type":468,"marks":679,"text":680},"282e17a9827c",[],": Executives gained access to up-to-date, entity-level and consolidated financial data for improved decision-making.",[],{"_key":683,"_type":684,"fullWidth":9,"htmlCode":685,"label":9,"markDefs":9},"ac1efa2aed21","htmlEmbed","\u003C!--HubSpot Call