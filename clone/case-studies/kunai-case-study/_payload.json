,"page":349,"type":34,"url":9},{"slug":169,"title":170},{"_key":351,"_type":28,"link":352,"text":176},"37977fbb53f2",{"linkPageModule":30,"newTab":30,"page":353,"type":34,"url":9},{"slug":175,"title":176},{"_key":355,"_type":28,"link":356,"text":182},"ce7211bbdf06",{"linkPageModule":30,"newTab":30,"page":357,"type":34,"url":9},{"slug":181,"title":182},{"_key":359,"_type":28,"link":360,"text":189},"c2cf79578089",{"linkPageModule":30,"newTab":30,"page":361,"type":34,"url":9},{"slug":188,"title":189},{"_key":363,"_type":28,"link":364,"text":158},"aa5c056f571d",{"linkPageModule":30,"newTab":30,"page":365,"type":34,"url":9},{"slug":157,"title":158},"By ERP","Solutions",{"_key":369,"_type":261,"children":370,"hasChildren":59,"hasComplex":30,"hasSubGroups":30,"label":117},"3ed1e90daf42",[371,375,379,383],{"_key":372,"_type":28,"link":373,"text":103},"ccdb6f145286",{"linkPageModule":30,"newTab":30,"page":374,"type":34,"url":9},{"slug":102,"title":103},{"_key":376,"_type":28,"link":377,"text":110},"8b88bd492913",{"linkPageModule":30,"newTab":30,"page":378,"type":34,"url":9},{"slug":109,"title":110},{"_key":380,"_type":28,"link":381,"text":116},"543fda435ee0",{"linkPageModule":30,"newTab":30,"page":382,"type":34,"url":9},{"slug":115,"title":116},{"_key":384,"_type":28,"link":385,"text":148},"d668686708d7",{"linkPageModule":30,"newTab":30,"page":386,"type":34,"url":9},{"slug":146,"title":147},{"_key":388,"_type":261,"children":389,"hasChildren":59,"hasComplex":30,"hasSubGroups":59,"label":224},"ec3c9c96a73a",[390,412],{"_key":391,"_type":320,"children":392,"label":411},"7f3f46db00b2",[393,397,401,405],{"_key":394,"_type":28,"link":395,"text":199},"91346855e74b",{"linkPageModule":30,"newTab":30,"page":396,"type":34,"url":9},{"slug":198,"title":9},{"_key":398,"_type":28,"link":399,"text":205},"73e52b9d612e",{"linkPageModule":30,"newTab":30,"page":400,"type":34,"url":9},{"slug":204,"title":9},{"_key":402,"_type":28,"link":403,"text":211},"6039453eeab9",{"linkPageModule":30,"newTab":30,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"aside":427,"blockText":461,"globalSeo":773,"headerImage":774,"orderRank":785,"seo":786,"slug":800,"sock":801,"text":9,"title":806},"036a99ed-6500-4148-9c36-33b98a391ecc","2NP1OABzpWPzKX7lI2CX3U","caseStudyEntry",[428,433,448,452],{"_key":429,"_type":430,"label":431,"text":432},"a1e93312c05b","asideText","Industry","Tech Industry",{"_key":434,"_type":435,"image":436,"label":447},"8a004125da05","asideImage",{"alt":9,"altText":437,"asset":438,"bgColor":440,"caption":9,"dimensions":441,"lqip":445,"originalFilename":446},"Intuit QuickBooks logo",{"_ref":439,"_type":13},"image-4399d49aba0e8e48935d1af24105b55640d4b2da-2345x600-png","#6aaa62",{"_type":16,"aspectRatio":442,"height":443,"width":444},3.908333333333333,600,2345,"data:image\u002Fpng;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAAFCAYAAABFA8wzAAAACXBIWXMAAAsTAAALEwEAmpwYAAABK0lEQVR4nE2QTyiDcRzGP7b3bdJSW7k47DA05M+Y2XhnWV5e7xLvtMaGkRRNlNjJxcHBzcnJ0Q5Lk51IlMPSysqZoyNX5eKi3\u002Folh6fn+zzfp289X8LFzuPY5eCLUQp\u002F6NdDhd5Tr2l323VgDdiQnAGWgEUgCDQDNqBBgr85dRuv5R6znweVre9cJVubuYrutkRcmqIoUWAMGAViwBQwDnTJgyqgAA7ACTTWdfYu8Z5\u002F2v46es7\u002F7FU336yyfthquUZUVQ0AA4AfCP07Klj4PqAD6AM0ye3Ey5HzzP1sdfVh\u002FjV5Y5RCZz3LTW0OA1u94gJgSSRl7RX5AqETQBpYB1LAHP0FjxYs+vaHi74T\u002F4U37dlxd+NE1BUhETaACYlJYBqIS1\u002F8WmhT7sxfTJtBvqvPtFQAAAAASUVORK5CYII=","intuit-qb.png","Accounting Software",{"_key":449,"_type":430,"label":450,"text":451},"cfa5ee616430","Company Size","200-500 Employees",{"_key":453,"_type":454,"items":455,"label":460},"25d62202148c","asideList",[456,457,458,459],"Fragmented Finance Systems","Manual Intercompany Eliminations","Delayed Month-End Close","Acquisition Due Diligence Readiness","Key Pain Points",[462,473,483,491,499,507,512,520,528,536,544,552,560,564,572,580,588,596,604,612,620,628,636,644,652,660,668,676,684,692,700,708,716,724,732,762,765],{"_key":463,"_type":464,"children":465,"markDefs":471,"style":472},"9f359e42b7b2","toolbar",[466],{"_key":467,"_type":468,"marks":469,"text":470},"7b69aaf171f2","span",[],"At a glance",[],"h2",{"_key":474,"_type":464,"children":475,"level":17,"listItem":480,"markDefs":481,"style":482},"7cb355639e5c",[476],{"_key":477,"_type":468,"marks":478,"text":479},"8a9cdf2431f8",[],"Kunai is a consultancy that provides IT engineering and staff augmentation for financial services companies. The company serves five of the top ten U.S. financial institutions","bullet",[],"normal",{"_key":484,"_type":464,"children":485,"level":17,"listItem":480,"markDefs":490,"style":482},"e0db760430ae",[486],{"_key":487,"_type":468,"marks":488,"text":489},"998969916c98",[],"Location: Operations across the United States, Mexico, Canada, and the United Kingdom",[],{"_key":492,"_type":464,"children":493,"level":17,"listItem":480,"markDefs":498,"style":482},"6ea2181f5d19",[494],{"_key":495,"_type":468,"marks":496,"text":497},"329b4a59aa6c",[],"Products used: Nominal’s AI‑powered finance platform",[],{"_key":500,"_type":464,"children":501,"level":17,"listItem":480,"markDefs":506,"style":482},"e09020291154",[502],{"_key":503,"_type":468,"marks":504,"text":505},"e3fb76a34efe",[],"Primary use cases: Multi‑entity consolidation, intercompany eliminations, month-end close automation, multi-currency FX translation, and audit-ready, GAAP-compliant books",[],{"_key":508,"_type":509,"citation":510,"markDefs":9,"text":511},"9df7031fec18","blockquote","Greg Hood, Head of Finance, Kunai","Nominal completely automated all my intercompany elimination entries. The AI agent suggests the eliminations instead of me having to go look and book them all.",{"_key":513,"_type":464,"children":514,"markDefs":519,"style":472},"fe81e04b0814",[515],{"_key":516,"_type":468,"marks":517,"text":518},"f882c05ada63",[],"Fragmented finance systems stall acquisition plans",[],{"_key":521,"_type":464,"children":522,"markDefs":527,"style":482},"938fb30fae09",[523],{"_key":524,"_type":468,"marks":525,"text":526},"5bf437833240",[],"Kunai, a consultancy providing senior-level IT engineering and staff-augmentation services, was on a stratospheric growth trajectory. The company had doubled in size every year for three years running, and counted five of the top ten U.S. financial institutions among its clients.",[],{"_key":529,"_type":464,"children":530,"markDefs":535,"style":482},"3be1a9aed3f0",[531],{"_key":532,"_type":468,"marks":533,"text":534},"69609f1beabb",[],"But like many high-growth startups, Kunai’s finance systems hadn’t kept up with the expansion. The company had opened entities in multiple countries over the previous year, each with its own chart of accounts, systems, and currencies.",[],{"_key":537,"_type":464,"children":538,"markDefs":543,"style":482},"8f3661bf7679",[539],{"_key":540,"_type":468,"marks":541,"text":542},"6de62b5d14d3",[],"The company was preparing for a potential acquisition, but needed to streamline and standardize the financials. To lead the charge, the team brought in Greg Hood, a seasoned fintech executive who has guided three successful M&A exits.",[],{"_key":545,"_type":464,"children":546,"markDefs":551,"style":482},"17bad35812c2",[547],{"_key":548,"_type":468,"marks":549,"text":550},"dbd23ec8c112",[],"Hood immediately encountered challenges. The web of spreadsheets and disconnected ledgers made even routine tasks a hassle. “Everything in Excel kept breaking,” he said, pointing to formulas and intercompany balances that constantly needed fixing. Month-end close took days — time the team didn’t have as they prepared for a potential deal.",[],{"_key":553,"_type":464,"children":554,"markDefs":559,"style":482},"061fa05ff7fe",[555],{"_key":556,"_type":468,"marks":557,"text":558},"16a8dfef0552",[],"An ERP migration would take months and cost a fortune, not ideal when bankers could come calling any day. Kunai needed a fast, reliable way to consolidate its books, ensure GAAP compliance, and produce audit-ready reports without overhauling its entire tech stack.",[],{"_key":561,"_type":562,"fullWidth":9,"htmlCode":563,"label":9,"markDefs":9},"899f182d08e4","htmlEmbed","\u003C!--HubSpot Call-to-Action Code -->\u003Cspan class=\"hs-cta-wrapper\" id=\"hs-cta-wrapper-c9564f84-d047-4064-96ba-ad0e2979c886\">\u003Cspan class=\"hs-cta-node hs-cta-c9564f84-d047-4064-96ba-ad0e2979c886\" id=\"hs-cta-c9564f84-d047-4064-96ba-ad0e2979c886\">\u003C!--[if lte IE 8]>\u003Cdiv id=\"hs-cta-ie-element\">\u003C\u002Fdiv>\u003C![endif]-->\u003Ca href=\"https:\u002F\u002Fcta-redirect.hubspot.com\u002Fcta\u002Fredirect\u002F48589798\u002Fc9564f84-d047-4064-96ba-ad0e2979c886\" target=\"_blank\" rel=\"noopener\">\u003Cimg class=\"hs-cta-img\" id=\"hs-cta-img-c9564f84-d047-4064-96ba-ad0e2979c886\" style=\"border-width:0px;\" src=\"https:\u002F\u002Fno-cache.hubspot.com\u002Fcta\u002Fdefault\u002F48589798\u002Fc9564f84-d047-4064-96ba-ad0e2979c886.png\"  alt=\"Unlock the Playbook: How Kunai Prepped for Acquisition in Weeks  Get the full case study to see how AI-powered finance saved time, cut costs, and simplified due diligence.  Download\"\u002F>\u003C\u002Fa>\u003C\u002Fspan>\u003Cscript charset=\"utf-8\" src=\"https:\u002F\u002Fjs.hscta.net\u002Fcta\u002Fcurrent.js\">\u003C\u002Fscript>\u003Cscript type=\"text\u002Fjavascript\"> hbspt.cta.load(48589798, 'c9564f84-d047-4064-96ba-ad0e2979c886', {\"useNewLoader\":\"true\",\"region\":\"na1\"}); \u003C\u002Fscript>\u003C\u002Fspan>\u003C!-- end HubSpot Call-to-Action Code -->",{"_key":565,"_type":464,"children":566,"markDefs":571,"style":472},"26a32c751ec6",[567],{"_key":568,"_type":468,"marks":569,"text":570},"a9c29c94adfb",[],"A fast, frictionless rollout with Nominal",[],{"_key":573,"_type":464,"children":574,"markDefs":579,"style":482},"958a171cd219",[575],{"_key":576,"_type":468,"marks":577,"text":578},"c3d6b5e2dc1c",[],"While evaluating options, Hood discovered Nominal at the Finance and Technology Expo in New York. After seeing how the platform could connect to both QuickBooks and Excel without requiring code or outside consultants, he signed on.",[],{"_key":581,"_type":464,"children":582,"markDefs":587,"style":482},"08d09dac4291",[583],{"_key":584,"_type":468,"marks":585,"text":586},"cc547ef35c0f",[],"Traditional ERPs promise consolidation, but often come with long timelines, big budgets, and a steep learning curve. Nominal took a different approach: instead of replacing Kunai’s existing systems, it layered on top of them, using automation and AI to handle consolidation, audit tracking, and real-time reporting.",[],{"_key":589,"_type":464,"children":590,"markDefs":595,"style":482},"979300c46eed",[591],{"_key":592,"_type":468,"marks":593,"text":594},"9cca2149dc9d",[],"For Kunai, that meant no downtime, no retraining, and no disruption to the business, all at a price well below what an ERP overhaul would cost.",[],{"_key":597,"_type":464,"children":598,"markDefs":603,"style":482},"3e13efef912b",[599],{"_key":600,"_type":468,"marks":601,"text":602},"7750fac473c7",[],"Implementation started immediately. The Nominal team worked with Kunai to map a 600-line P&L into an 18-line version, then automated currency translations and eliminations. The team pulled QuickBooks information into Nominal in less time than it takes to drink a cup of coffee. “We linked into QuickBooks in a matter of minutes,” Hood said.",[],{"_key":605,"_type":464,"children":606,"markDefs":611,"style":482},"33ea901dce93",[607],{"_key":608,"_type":468,"marks":609,"text":610},"ec567877b6fe",[],"Nominal also set up a dedicated Slack channel for Kunai and held weekly check-ins to keep things moving. Their collaborative, clear, no-jargon approach made the process feel more like a true partnership than just another IT rollout.",[],{"_key":613,"_type":464,"children":614,"markDefs":619,"style":472},"c174c4b8f88d",[615],{"_key":616,"_type":468,"marks":617,"text":618},"5943b97c2d52",[],"AI-powered finance creates ROI in record time",[],{"_key":621,"_type":464,"children":622,"markDefs":627,"style":482},"05b7d222b16f",[623],{"_key":624,"_type":468,"marks":625,"text":626},"91cca46a912e",[],"The results came quickly. After one training cycle, Nominal’s AI agents began suggesting elimination entries that balanced intercompany accounts in seconds. Manual reconciliations disappeared, and Kunai cut a full day from its monthly close schedule.",[],{"_key":629,"_type":464,"children":630,"markDefs":635,"style":482},"383c12213d89",[631],{"_key":632,"_type":468,"marks":633,"text":634},"d01b3648633b",[],"Cash flow statements and variance analyses were generated automatically. According to Hood, Nominal’s AI agents caught and resolved about 75% of anomalies before the finance team even had to step in.",[],{"_key":637,"_type":464,"children":638,"markDefs":643,"style":482},"c81068b89c9d",[639],{"_key":640,"_type":468,"marks":641,"text":642},"9d34fdbcdaf2",[],"Over the six-month sprint leading up to the acquisition, Nominal saved the Kunai team an estimated 80 to 90 hours of manual work. The platform also helped them avoid up to $20,000 in temporary staffing and overtime costs. ",[],{"_key":645,"_type":464,"children":646,"markDefs":651,"style":482},"b1e6ed348c61",[647],{"_key":648,"_type":468,"marks":649,"text":650},"22f37737b01c",[],"Just as important: the platform gave them confidence that numbers wouldn’t shift between close cycles. Audit‑ready drill‑downs make it easy to trace any consolidated balance to its source transaction in a few clicks, eliminating the back‑and‑forth that previously took days.",[],{"_key":653,"_type":464,"children":654,"markDefs":659,"style":472},"029f8a784bb3",[655],{"_key":656,"_type":468,"marks":657,"text":658},"c734ede9cd6e",[],"Clean books helped close the deal",[],{"_key":661,"_type":464,"children":662,"markDefs":667,"style":482},"baf474aab208",[663],{"_key":664,"_type":468,"marks":665,"text":666},"8ec181794210",[],"When an acquiring company kicked off due diligence, the Kunai team was ready. Nominal provided a consolidated, GAAP-compliant view built directly from the company’s existing ledgers. That freed Hood to focus on the dozens of other tasks required for a successful exit. “Nominal cut our time to acquisition and saved me an ERP implementation,” he said.",[],{"_key":669,"_type":464,"children":670,"markDefs":675,"style":482},"3fb75d641585",[671],{"_key":672,"_type":468,"marks":673,"text":674},"19ead738ec65",[],"The clarity Nominal provided helped de‑risk the transaction, shortening the financial workstream and paving the way for Kunai’s successful sale. The platform’s automated mappings and eliminations meant Kunai could meet due diligence requests with confidence — no late nights or restatements required.",[],{"_key":677,"_type":464,"children":678,"markDefs":683,"style":472},"49f2e68892be",[679],{"_key":680,"_type":468,"marks":681,"text":682},"618ad041ad37",[],"Future‑ready finance ",[],{"_key":685,"_type":464,"children":686,"markDefs":691,"style":482},"e942e3294204",[687],{"_key":688,"_type":468,"marks":689,"text":690},"5098acc495d5",[],"After the successful acquisition, Hood is now advising multiple high‑growth clients through his consultancy, SkySight Analytics, and has added Nominal to his recommended finance tech stack. ",[],{"_key":693,"_type":464,"children":694,"markDefs":699,"style":482},"2abc4e5c7838",[695],{"_key":696,"_type":468,"marks":697,"text":698},"0f326ed9baa5",[],"Hood positions the platform as a cost‑effective alternative to expensive, time-consuming ERP projects. The goal? To enable finance teams to scale revenue, not headcount, while gaining real‑time insights and AI‑driven assurance.",[],{"_key":701,"_type":464,"children":702,"markDefs":707,"style":482},"ba0ad721aee7",[703],{"_key":704,"_type":468,"marks":705,"text":706},"4f61d0dcc80a",[],"“Spend less time doing, more time analyzing” is the advice that Hood shares with founders considering an exit. Nominal helps make that possible, turning disconnected systems into a single source of truth and giving companies a future-ready finance setup at a fraction of the usual cost.",[],{"_key":709,"_type":464,"children":710,"markDefs":715,"style":482},"a24aebeb8669",[711],{"_key":712,"_type":468,"marks":713,"text":714},"aa1da00a22e3",[],"Said Hood: “There's no need to spend a hundred thousand dollars on a full ERP implementation when you have a great, cost-effective tool like Nominal.”",[],{"_key":717,"_type":464,"children":718,"markDefs":723,"style":472},"746dda9997d2",[719],{"_key":720,"_type":468,"marks":721,"text":722},"bdaf5cad1208",[],"About Nominal",[],{"_key":725,"_type":464,"children":726,"markDefs":731,"style":482},"322054a54b76",[727],{"_key":728,"_type":468,"marks":729,"text":730},"93fee0c79f11",[],"Nominal is an AI-powered finance automation platform that overlays any ERP. It automates multi-entity consolidation, intercompany eliminations, and month-end close management — helping accounting teams reconcile faster, consolidate cleaner, and close with confidence.",[],{"_key":733,"_type":464,"children":734,"markDefs":757,"style":482},"3a8ec6ba9d01",[735,739,744,748,753],{"_key":736,"_type":468,"marks":737,"text":738},"9c053b38f5cb",[],"See Nominal in action",{"_key":740,"_type":468,"marks":741,"text":743},"d0d6b37e530c",[742],"strong",":",{"_key":745,"_type":468,"marks":746,"text":747},"ca653aaa739b",[]," ",{"_key":749,"_type":468,"marks":750,"text":752},"493bbf3980a5",[751],"dbbbaacbd6d8","book a demo",{"_key":754,"_type":468,"marks":755,"text":756},"5672c4be0216",[742],".",[758],{"_key":751,"_type":759,"linkPageModule":30,"newTab":59,"page":760,"type":124,"url":761},"link",{"slug":251,"title":252},"https:\u002F\u002Fnominal.so\u002Fbook-a-demo?utm_medium=organic&utm_source=blog&utm_campaign=book-demo-blog",{"_key":763,"_type":562,"fullWidth":9,"htmlCode":764,"label":9,"markDefs":9},"e3f317bb8c93","\u003C!--HubSpot Call-to-Action Code -->\u003Cspan class=\"hs-cta-wrapper\" id=\"hs-cta-wrapper-e7c4bd50-1946-4926-8e1a-e2a8185165df\">\u003Cspan class=\"hs-cta-node hs-cta-e7c4bd50-1946-4926-8e1a-e2a8185165df\" id=\"hs-cta-e7c4bd50-1946-4926-8e1a-e2a8185165df\">\u003C!--[if lte IE 8]>\u003Cdiv id=\"hs-cta-ie-element\">\u003C\u002Fdiv>\u003C![endif]-->\u003Ca href=\"https:\u002F\u002Fcta-redirect.hubspot.com\u002Fcta\u002Fredirect\u002F48589798\u002Fe7c4bd50-1946-4926-8e1a-e2a8185165df\" >\u003Cimg class=\"hs-cta-img\" id=\"hs-cta-img-e7c4bd50-1946-4926-8e1a-e2a8185165df\" style=\"border-width:0px;\" src=\"https:\u002F\u002Fno-cache.hubspot.com\u002Fcta\u002Fdefault\u002F48589798\u002Fe7c4bd50-1946-4926-8e1a-e2a8185165df.png\"  alt=\"Better Automation. Better Decisions.  Book a Demo\"\u002F>\u003C\u002Fa>\u003C\u002Fspan>\u003Cscript charset=\"utf-8\" src=\"https:\u002F\u002Fjs.hscta.net\u002Fcta\u002Fcurrent.js\">\u003C\u002Fscript>\u003Cscript type=\"text\u002Fjavascript\"> hbspt.cta.load(48589798, 'e7c4bd50-1946-4926-8e1a-e2a8185165df', {\"useNewLoader\":\"true\",\"region\":\"na1\"}); \u003C\u002Fscript>\u003C\u002Fspan>\u003C!-- end HubSpot Call-to-Action Code -->",{"_key":766,"_type":464,"children":767,"markDefs":772,"style":482},"c4c2b20c248a",[768],{"_key":769,"_type":468,"marks":770,"text":771},"4a54b012a306",[],"",[],{"description":9,"image":9,"title":9},{"alt":9,"altText":775,"asset":776,"bgColor":778,"caption":9,"dimensions":779,"lqip":783,"originalFilename":784},"Kunai logo on a red layered-block background",{"_ref":777,"_type":13},"image-32d5014b076d5713587a2ac2b556bc72