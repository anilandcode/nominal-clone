Tab":30,"page":404,"type":34,"url":9},{"slug":210,"title":9},{"_key":406,"_type":28,"link":407,"text":410},"25078e5f70d1",{"linkPageModule":30,"newTab":30,"page":408,"type":34,"url":9},{"slug":409,"title":410},"\u002Fagentic-performance-management-hub","APM Resource Hub","Learn",{"_key":413,"_type":320,"children":414,"label":149},"28964dbb83f8",[415,419],{"_key":416,"_type":28,"link":417,"text":217},"d3d5ec6f8fc7",{"linkPageModule":30,"newTab":30,"page":418,"type":34,"url":9},{"slug":216,"title":9},{"_key":420,"_type":28,"link":421,"text":223},"d3b7f9b3ef47",{"linkPageModule":30,"newTab":30,"page":422,"type":34,"url":9},{"slug":222,"title":9},{"_id":424,"_rev":425,"_type":426,"aside":427,"blockText":461,"globalSeo":749,"headerImage":750,"orderRank":761,"seo":762,"slug":770,"sock":771,"text":9,"title":768},"8bc75733-e4b0-477b-9cab-13e5a266b9b2","2NP1OABzpWPzKX7lI2CX3U","caseStudyEntry",[428,433,448,452],{"_key":429,"_type":430,"label":431,"text":432},"d851a3f19368","asideText","Industry","Consumer lending (Buy Now, Pay Later)",{"_key":434,"_type":435,"image":436,"label":447},"873eeadb309c","asideImage",{"alt":9,"altText":437,"asset":438,"bgColor":440,"caption":9,"dimensions":441,"lqip":445,"originalFilename":446},"Pantheon logo",{"_ref":439,"_type":13},"image-01081aeceb09f18657008b75f3c51c1ddb2fe362-480x112-png","#3b454b",{"_type":16,"aspectRatio":442,"height":443,"width":444},4.285714285714286,112,480,"data:image\u002Fpng;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAAFCAYAAABFA8wzAAAACXBIWXMAAAsTAAALEwEAmpwYAAABYklEQVR4nGOIzyqOTS+sWJtRVHkyJb+0KTQxXUtLS4tHRUWFD4RFRUXBbHl5eQE5OTlBEFtdXZ0XxFdSUuKHYZAeSUlJLobM4qrNE2bMuztzwbK3DV0T98Sm5UVpaekbKMnJOakoKLiBaUVFV0UIdlFRULBXUlJyUpKX91SUlXVVlJNzAbHV5ZUd1JWUdBnSCioez1u66svG7bt\u002Fd0yYfj0qNadMT8\u002FQQ0VOLllZTq4EhFUVFEpUlJQy1BQUYlXllRJUFRVzVBUUSpXl5HJU5OWzVBQUytQUFbM1FBVdGeKzi7f2TZtza87ilS+qW3p3hSdkRGkZGGgpysiYglwEsl1NXt5DVVHRVl1JyURVQcFcWVnZESSuICvrBnKlsry8h4qCir2qvLwmQ1hKTlxKYfmi9KLK3QlZpTUBsZmaMhYWnPLy8hygcEEOI3FxcW5QOIHCECQGCkcQBoWrlqgWD0gPAGWPYN9nkjh0AAAAAElFTkSuQmCC","leanpay.png","Accounting Software",{"_key":449,"_type":430,"label":450,"text":451},"cef1e7d98523","Company Size","51 - 200 employees",{"_key":453,"_type":454,"items":455,"label":460},"99c086a79697","asideList",[456,457,458,459],"Multi-Entity Excel Consolidations","Error-Prone Manual Workflows","Slow Year-End Close Process","Limited Transparency for Investors","Key Pain Points",[462,473,483,491,499,507,512,520,528,536,544,552,560,568,576,584,592,600,604,612,620,628,636,644,652,660,668,676,684,692,700,708,716,746],{"_key":463,"_type":464,"children":465,"markDefs":471,"style":472},"be8cf487af74","toolbar",[466],{"_key":467,"_type":468,"marks":469,"text":470},"14bc5a92db4b","span",[],"At a glance",[],"h2",{"_key":474,"_type":464,"children":475,"level":17,"listItem":480,"markDefs":481,"style":482},"348e3dc4f2a1",[476],{"_key":477,"_type":468,"marks":478,"text":479},"bd68e38e20ac",[],"Leanpay offers fully digital, automated installment payment solutions for online and in-store purchases, integrated with instant credit checks. ","bullet",[],"normal",{"_key":484,"_type":464,"children":485,"level":17,"listItem":480,"markDefs":490,"style":482},"ad8bf3e15c3d",[486],{"_key":487,"_type":468,"marks":488,"text":489},"63932be12515",[],"Location: Headquartered in the UK, with operations in Slovenia, Romania, and Hungary, and a Serbian subsidiary",[],{"_key":492,"_type":464,"children":493,"level":17,"listItem":480,"markDefs":498,"style":482},"c0474870fddb",[494],{"_key":495,"_type":468,"marks":496,"text":497},"3a4fcb7ee6c3",[],"Products used: Nominal’s AI‑powered finance platform ",[],{"_key":500,"_type":464,"children":501,"level":17,"listItem":480,"markDefs":506,"style":482},"41c6868a6cf9",[502],{"_key":503,"_type":468,"marks":504,"text":505},"92ba8184237d",[],"Primary use cases: Multi-entity consolidation, multi-currency translation, intercompany eliminations, investor reporting",[],{"_key":508,"_type":509,"citation":510,"markDefs":9,"text":511},"b5f7db0046e0","blockquote","Jan Grižon, Head of Finance, Leanpay","With Nominal, we’ve cut at least two days from our close each month, and we save weeks during our end-of-year consolidation.",{"_key":513,"_type":464,"children":514,"markDefs":519,"style":482},"85e69384cda2",[515],{"_key":516,"_type":468,"marks":517,"text":518},"1a4f896b7205",[],"Leanpay is a fast-growing Buy Now, Pay Later provider operating in multiple European markets. The company is currently integrated into over 1,000 point-of-sale systems. With entities in five different countries, several currencies in play, and a rapid growth trajectory — including €100 million in loans issued in the 2024 fiscal year — the finance team faced mounting consolidation challenges.",[],{"_key":521,"_type":464,"children":522,"markDefs":527,"style":482},"15524ca1f014",[523],{"_key":524,"_type":468,"marks":525,"text":526},"5757a4a78c27",[],"Before implementing Nominal, monthly and year-end consolidations were performed entirely in Excel. Each entity had its own workbook, linked to a separate consolidation file, plus a standalone intercompany eliminations file. This process was cumbersome, error-prone, and slow.",[],{"_key":529,"_type":464,"children":530,"markDefs":535,"style":482},"b22afbd5f425",[531],{"_key":532,"_type":468,"marks":533,"text":534},"796c37312d22",[],"“I would get to the final P&L or balance sheet for our investors, management, and other stakeholders, but if someone asked what’s in a particular account, I would need to go back and shuffle through all these standalone Excel files,” said Jan Grižon, Leanpay’s Head of Finance. “It was confusing and time-consuming. “",[],{"_key":537,"_type":464,"children":538,"markDefs":543,"style":482},"bb69e236d4fa",[539],{"_key":540,"_type":468,"marks":541,"text":542},"1e0e488d028c",[],"These limitations affected more than just internal efficiency. Consolidation delays and limited transparency made it harder to respond to investor, bank, and auditor queries quickly — an important factor for a rapidly growing company.",[],{"_key":545,"_type":464,"children":546,"markDefs":551,"style":472},"8d84ae240696",[547],{"_key":548,"_type":468,"marks":549,"text":550},"6e12508e1a60",[],"A Platform Built for Multi-Currency, Multi-Entity Finance",[],{"_key":553,"_type":464,"children":554,"markDefs":559,"style":482},"eed424fb2964",[555],{"_key":556,"_type":468,"marks":557,"text":558},"996df73c01da",[],"In early 2024, Head of Finance Jan Grižon began searching for a consolidation platform that could handle multi-currency, multi-entity consolidation without a lengthy ERP overhaul. He discovered Nominal on LinkedIn and set up a demo. “We evaluated Nominal along with two other providers, and Nominal was the best fit for our needs,” he said.",[],{"_key":561,"_type":464,"children":562,"markDefs":567,"style":482},"13d9331c0763",[563],{"_key":564,"_type":468,"marks":565,"text":566},"a6fa704b1b77",[],"Key factors in the decision included Nominal’s robust multi-currency consolidation capabilities, such as automatic translation from local currencies to Leanpay’s consolidation currency. Live ERP integration provided a daily data feed from Leanpay’s accounting systems to Nominal, eliminating the need for manual uploads. Streamlined workflows simplified the matching and clearing of intercompany transactions. ",[],{"_key":569,"_type":464,"children":570,"markDefs":575,"style":482},"b4ab0dcd3f5c",[571],{"_key":572,"_type":468,"marks":573,"text":574},"57e4f0b5b75e",[],"Transparency and drill-down functionality were also essential. With Nominal, the team can now move seamlessly from consolidated or entity-level results to local account details with just a few clicks.",[],{"_key":577,"_type":464,"children":578,"markDefs":583,"style":472},"3c97930ae154",[579],{"_key":580,"_type":468,"marks":581,"text":582},"71ae44f68cf2",[],"A Seamless Implementation With Immediate Value",[],{"_key":585,"_type":464,"children":586,"markDefs":591,"style":482},"8ffa000db6f3",[587],{"_key":588,"_type":468,"marks":589,"text":590},"b5728b5b38a9",[],"Leanpay initiated discussions with the Nominal team in Q2 of 2024 and implemented Nominal within a few weeks. Nominal’s three-month risk-free evaluation period allowed the finance team to test live integrations and workflows before committing. “The Nominal implementation was almost effortless from my end,” said Grižon. “We gave them access to our accounting database, and they took it all from there.”",[],{"_key":593,"_type":464,"children":594,"markDefs":599,"style":482},"75d93c97b652",[595],{"_key":596,"_type":468,"marks":597,"text":598},"35b659ac898f",[],"Because both companies use Slack, the deployment and support process felt collaborative and immediate. “It was like we had an internal unit within Leanpay working solely on this project for us,” he added.",[],{"_key":601,"_type":602,"fullWidth":9,"htmlCode":603,"label":9,"markDefs":9},"2e304e874b4b","htmlEmbed","\u003C!--HubSpot Call-to-Action Code -->\u003Cspan class=\"hs-cta-wrapper\" id=\"hs-cta-wrapper-b2e9caf9-8962-4f07-a7ad-cd989aa6ba9c\">\u003Cspan class=\"hs-cta-node hs-cta-b2e9caf9-8962-4f07-a7ad-cd989aa6ba9c\" id=\"hs-cta-b2e9caf9-8962-4f07-a7ad-cd989aa6ba9c\">\u003C!--[if lte IE 8]>\u003Cdiv id=\"hs-cta-ie-element\">\u003C\u002Fdiv>\u003C![endif]-->\u003Ca href=\"https:\u002F\u002Fcta-redirect.hubspot.com\u002Fcta\u002Fredirect\u002F48589798\u002Fb2e9caf9-8962-4f07-a7ad-cd989aa6ba9c\" target=\"_blank\" rel=\"noopener\">\u003Cimg class=\"hs-cta-img\" id=\"hs-cta-img-b2e9caf9-8962-4f07-a7ad-cd989aa6ba9c\" style=\"border-width:0px;\" src=\"https:\u002F\u002Fno-cache.hubspot.com\u002Fcta\u002Fdefault\u002F48589798\u002Fb2e9caf9-8962-4f07-a7ad-cd989aa6ba9c.png\"  alt=\"From Weeks to Days: Leanpay’s Close Transformation With Nominal  Learn how Leanpay’s finance team replaced Excel chaos with automated accuracy.  Download\"\u002F>\u003C\u002Fa>\u003C\u002Fspan>\u003Cscript charset=\"utf-8\" src=\"https:\u002F\u002Fjs.hscta.net\u002Fcta\u002Fcurrent.js\">\u003C\u002Fscript>\u003Cscript type=\"text\u002Fjavascript\"> hbspt.cta.load(48589798, 'b2e9caf9-8962-4f07-a7ad-cd989aa6ba9c', {\"useNewLoader\":\"true\",\"region\":\"na1\"}); \u003C\u002Fscript>\u003C\u002Fspan>\u003C!-- end HubSpot Call-to-Action Code -->",{"_key":605,"_type":464,"children":606,"markDefs":611,"style":472},"4f5a18c0c284",[607],{"_key":608,"_type":468,"marks":609,"text":610},"29506fbf9485",[],"From Manual Chaos to Automated Accuracy ",[],{"_key":613,"_type":464,"children":614,"markDefs":619,"style":482},"d7faa2095a8d",[615],{"_key":616,"_type":468,"marks":617,"text":618},"d34c8647f2d6",[],"Since going live with Nominal, the finance team has seen outstanding efficiency gains. Month-end close time has decreased by at least two days — a 20 to 25% improvement. Year-end close has been shortened by weeks, even with Leanpay’s increased transaction volume. ",[],{"_key":621,"_type":464,"children":622,"markDefs":627,"style":482},"99dad7829927",[623],{"_key":624,"_type":468,"marks":625,"text":626},"ba5551fdd4f4",[],"With the direct ERP integration, the company has eliminated the manual mapping and data import steps that used to follow every close in the Excel era. Now, once local trial balances are finalized, the data appears in Nominal automatically, mapped, consolidated, and ready for review. Nominal also flags potential oversights, like unreversed accruals, helping the team catch and correct errors before they become issues.",[],{"_key":629,"_type":464,"children":630,"markDefs":635,"style":482},"856da1759764",[631],{"_key":632,"_type":468,"marks":633,"text":634},"a421e117234d",[],"“Nominal and Excel aren’t even playing the same sport,” said Grižon. “Now, with Nominal, when we finish our consolidation, I’m completely sure that our accounts are accurate.”",[],{"_key":637,"_type":464,"children":638,"markDefs":643,"style":482},"c34c75529b71",[639],{"_key":640,"_type":468,"marks":641,"text":642},"7e698dcb9f7b",[],"Nominal’s real-time reporting capabilities also give the company a competitive advantage. Investor and bank queries that once took half a day to address are now answered much more quickly, thanks to Nominal’s on-demand transparency and drill-down capabilities. ",[],{"_key":645,"_type":464,"children":646,"markDefs":651,"style":482},"b10c6b2f7435",[647],{"_key":648,"_type":468,"marks":649,"text":650},"70023660a94f",[],"The side-by-side entity view in Nominal has also been a game-changer for them. Grižon can open a consolidated balance sheet, see how totals are derived, and drill down directly into any figure. “There’s now really less need to spend hours preparing before meetings and presentations,” he said. “I can have Nominal open on my laptop and answer questions on the spot, because it offers transparency for all our accounts.”",[],{"_key":653,"_type":464,"children":654,"markDefs":659,"style":482},"c5dadff9b20a",[655],{"_key":656,"_type":468,"marks":657,"text":658},"993685c0ff10",[],"As Leanpay expands into new markets, Nominal’s transparency continues to help the company build trust and credibility with investors and bank partners. “It facilitates access to capital,” Grižon said. “Nominal really helps improve relations with investors and outside partners, which gives Leanpay a better platform to grow.”",[],{"_key":661,"_type":464,"children":662,"markDefs":667,"style":472},"bab861ddcf3e",[663],{"_key":664,"_type":468,"marks":665,"text":666},"2e8c781c991f",[],"The Future of Finance at Leanpay: Unlocking the Power of AI",[],{"_key":669,"_type":464,"children":670,"markDefs":675,"style":482},"90d428eaf535",[671],{"_key":672,"_type":468,"marks":673,"text":674},"044e796a86bf",[],"While Leanpay has not yet adopted all of Nominal’s AI capabilities, Grizon sees potential in features like Nominal’s AI-generated variance summaries and automated intercompany matching. ",[],{"_key":677,"_type":464,"children":678,"markDefs":683,"style":482},"a678250a589a",[679],{"_key":680,"_type":468,"marks":681,"text":682},"b033e8d5bcbf",[],"Nominal recently introduced an AI-powered subledger-to-trial balance reconciliation, which will flag missing accrual reversals or mismatches before close. “Nominal helps us gather and reconcile all our data and warns us about things we might have missed,” said Grižon. “It helps catch human errors and improve efficiency.” ",[],{"_key":685,"_type":464,"children":686,"markDefs":691,"style":482},"884444627b96",[687],{"_key":688,"_type":468,"marks":689,"text":690},"2e730059cd50",[],"Grižon also highlighted the Nominal team’s collaborative approach. “The customer support they have is world-class,” he said. “We really feel like they (the Nominal team) are an extension of Leanpay.”",[],{"_key":693,"_type":464,"children":694,"markDefs":699,"style":482},"546414dca637",[695],{"_key":696,"_type":468,"marks":697,"text":698},"9f4de8256ae4",[],"Nominal has done more than improve Leanpay’s month-end close: it has reshaped how the finance team works. The team can now focus on the next stage of company growth, confident that its financial reporting is both accurate and investor-ready.",[],{"_key":701,"_type":464,"children":702,"markDefs":707,"style":472},"f488b43c86cf",[703],{"_key":704,"_type":468,"marks":705,"text":706},"b8020f26a33c",[],"About Nominal",[],{"_key":709,"_type":464,"children":710,"markDefs":715,"style":482},"739db2ad8ad9",[711],{"_key":712,"_type":468,"marks":713,"text":714},"12b012d9d03d",[],"Nominal is an AI-powered finance automation platform that overlays any ERP. It automates multi-entity consolidation, intercompany eliminations, and month-end close management — helping accounting teams reconcile faster, consolidate cleaner, and close with confidence.",[],{"_key":717,"_type":464,"children":718,"markDefs":741,"style":482},"0d3db7b41759",[719,723,728,732,737],{"_key":720,"_type":468,"marks":721,"text":722},"f02beb81744a",[],"See Nominal in action",{"_key":724,"_type":468,"marks":725,"text":727},"0545fd544bc2",[726],"strong",":",{"_key":729,"_type":468,"marks":730,"text":731},"891b52d68e92",[]," ",{"_key":733,"_type":468,"marks":734,"text":736},"276de27bafa5",[735],"b1faa5ec35d3","book a demo",{"_key":738,"_type":468,"marks":739,"text":740},"855f8d2fefd6",[726],".",[742],{"_key":735,"_type":743,"linkPageModule":30,"newTab":59,"page":744,"type":124,"url":745},"link",{"slug":251,"title":252},"https:\u002F\u002Fnominal.so\u002Fbook-a-demo?utm_medium=organic&utm_source=blog&utm_campaign=book-demo-blog",{"_key":747,"_type":602,"fullWidth":9,"htmlCode":748,"label":9,"markDefs":9},"36ec4d5dff89","\u003C!--HubSpot Call-to-Action Code -->\u003Cspan class=\"hs-cta-wrapper\" id=\"hs-cta-wrapper-e7c4bd50-1946-4926-8e1a-e2a8185165df\">\u003Cspan class=\"hs-cta-node hs-cta-e7c4bd50-1946-4926-8e1a-e2a8185165df\" id=\"hs-cta-e7c4bd50-1946-4926-8e1a-e2a8185165df\">\u003C!--[if lte IE 8]>\u003Cdiv id=\"hs-cta-ie-element\">\u003C\u002Fdiv>\u003C![endif]-->\u003Ca href=\"https:\u002F\u002Fcta-redirect.hubspot.com\u002Fcta\u002Fredirect\u002F48589798\u002Fe7c4bd50-1946-4926-8e1a-e2a8185165df\" >\u003Cimg class=\"hs-cta-img\" id=\"hs-cta-img-e7c4bd50-1946-4926-8e1a-e2a8185165df\" style=\"border-width:0px;\" src=\"https:\u002F\u002Fno-cache.hubspot.com\u002Fcta\u002Fdefault\u002F48589798\u002Fe7c4bd50-1946-4926-8e1a-e2a8185165df.png\"  alt=\"Better Automation. Better Decisions.  Book a Demo\"\u002F>\u003C\u002Fa>\u003C\u002Fspan>\u003Cscript charset=\"utf-8\" src=\"https:\u002F\u002Fjs.hscta.net\u002Fcta\u002Fcurrent.js\">\u003C\u002Fscript>\u003Cscript type=\"text\u002Fjavascript\"> hbspt.cta.load(48589798, 'e7c4bd50-1946-4926-8e1a-e2a8185165df', {\"useNewLoader\":\"true\",\"region\":\"na1\"}); \u003C\u002Fscript>\u003C\u002Fspan>\u003C!-- end HubSpot Call-to-Action Code -->",{"description":9,"image":9,"title":9},{"alt":9,"altText":751,"asset":752,"bgColor":754,"caption":9,"dimensions":755,"lqip":759,"originalFilename":760},"Leanpay logo on a yellow layered-block background",{"_ref":753,"_type":13},"image-8c9324b3ead8bde542bda1d5fa35